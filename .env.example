# The author's own keys, for the checks with a real model and `pnpm template:image generate` (Q438).
# Copy this file to .env at the repository's root (git ignores it) and fill in the keys you have;
# a .env in the main checkout serves its worktrees too. A key set in the terminal wins over this file.
# Never read by the app itself: a maker's keys go in Accounts.

# Google AI Studio: Gemini for the Pi harness's checks, and Gemini's image models.
GEMINI_API_KEY=
# OpenAI: its image models.
OPENAI_API_KEY=

# Each real check still runs only when asked:
#   UPSTART_REAL_PI=1 pnpm exec vitest run --config e2e/vitest.config.ts e2e/agent-pi.e2e.ts
#   UPSTART_REAL_IMAGES=1 pnpm --filter @upstart/desktop exec vitest run src/main/images/generate.real.test.ts

{
  "name": "upstart",
  "private": true,
  "description": "Upstart: build websites by talking to an agent, on your own machine.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "pnpm --filter @upstart/desktop build && pnpm background-electron && vitest run --config e2e/vitest.config.ts",
    "background-electron": "node scripts/background-electron.ts",
    "template:check": "node apps/desktop/scripts/template.mjs check",
    "template:shoot": "node apps/desktop/scripts/template.mjs shoot",
    "start": "pnpm --filter @upstart/desktop start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.160.1",
    "yaml": "2.9.1"
  }
}

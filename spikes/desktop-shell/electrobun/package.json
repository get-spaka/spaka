{
  "name": "upstart-spike-shell-electrobun",
  "private": true,
  "version": "0.0.1",
  "description": "Throwaway: spike 2 (desktop shell), Electrobun side.",
  "type": "module",
  "scripts": {
    "view": "vite build",
    "dev": "vite build && HUTCH_HOME=\"$PWD/.hutch-home\" electrobun dev",
    "dev:watch": "vite build && HUTCH_HOME=\"$PWD/.hutch-home\" electrobun dev --watch",
    "package": "vite build && HUTCH_HOME=\"$PWD/.hutch-home\" electrobun build --env=stable",
    "app": "open -n 'build/stable-macos-arm64/Upstart Spike Electrobun.app'",
    "app:cef": "open -n 'build-cef/stable-macos-arm64/Upstart Spike Electrobun CEF.app'",
    "package:cef": "vite build && SPIKE_CEF=1 HUTCH_HOME=\"$PWD/.hutch-home\" electrobun build --env=stable"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "latest",
    "@vitejs/plugin-react": "6.3.0",
    "electrobun": "2.0.6",
    "modern-screenshot": "4.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.7"
  }
}

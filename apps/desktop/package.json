{
  "name": "@upstart/desktop",
  "productName": "Upstart",
  "private": true,
  "version": "0.1.0",
  "description": "Build websites by talking to an agent, on your own machine.",
  "author": "Upstart",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/bundle-hosts.mjs && electron-vite dev",
    "dev:live": "node scripts/bundle-hosts.mjs && cross-env UPSTART_SHOW_INACTIVE=1 electron-vite dev --watch",
    "build": "electron-vite build && node scripts/bundle-hosts.mjs",
    "start": "pnpm build && electron .",
    "package": "pnpm build && node scripts/template.mjs snapshot && electron-builder --mac --arm64 --dir -c.mac.identity=null --publish never",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "hosts": "node scripts/bundle-hosts.mjs",
    "icon": "node scripts/icon.mjs",
    "dist:mac": "pnpm build && node scripts/template.mjs snapshot && electron-builder --mac --arm64 --publish never",
    "dist:win": "pnpm build && node scripts/template.mjs snapshot && electron-builder --win --x64 --publish never",
    "package:win": "pnpm build && node scripts/template.mjs snapshot && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@tailwindcss/browser": "4.3.5",
    "@upstart/builder": "workspace:*",
    "@upstart/runtime": "workspace:*",
    "daisyui": "5.7.50",
    "electron-updater": "6.8.11",
    "htmx.org": "4.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "10.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "idiomorph": "0.8.0",
    "lucide-react": "1.71.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.2.18",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.7"
  },
  "build": {
    "appId": "gg.upstart.desktop",
    "productName": "Upstart",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "!out/hosts/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "electronLanguages": [
      "en",
      "fr"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "signIgnore": [
        "claude-agent-sdk-darwin-arm64/claude$"
      ],
      "minimumSystemVersion": "13.0"
    },
    "extraResources": [
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "gallery",
        "to": "gallery"
      },
      {
        "from": "fonts",
        "to": "fonts"
      },
      {
        "from": "templates-catalogue",
        "to": "templates-catalogue"
      },
      {
        "from": "out/hosts",
        "to": "hosts"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "upstart-gg",
        "repo": "upstart-editor",
        "releaseType": "draft"
      }
    ],
    "dmg": {
      "artifactName": "Upstart-${version}-${arch}.${ext}"
    },
    "artifactName": "Upstart-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Upstart-Setup-${version}-${arch}.${ext}",
      "shortcutName": "Upstart",
      "deleteAppDataOnUninstall": false
    }
  }
}

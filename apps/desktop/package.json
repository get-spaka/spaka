{
  "name": "@upstart/desktop",
  "productName": "Upstart",
  "private": true,
  "version": "0.1.0",
  "description": "Build websites by talking to an agent, on your own machine.",
  "author": "Upstart",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/bundle-hosts.mjs && electron-vite dev",
    "dev:live": "node scripts/bundle-hosts.mjs && UPSTART_SHOW_INACTIVE=1 electron-vite dev --watch",
    "build": "electron-vite build && node scripts/bundle-hosts.mjs",
    "start": "pnpm build && electron .",
    "package": "pnpm build && node scripts/template.mjs snapshot && electron-builder --mac --arm64 --publish never",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "hosts": "node scripts/bundle-hosts.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@tailwindcss/browser": "4.3.5",
    "@upstart/builder": "workspace:*",
    "@upstart/runtime": "workspace:*",
    "daisyui": "5.7.50",
    "htmx.org": "4.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "idiomorph": "0.8.0",
    "lucide-react": "1.71.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.2.18",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.7"
  },
  "build": {
    "appId": "gg.upstart.desktop",
    "productName": "Upstart",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "!out/hosts/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "electronLanguages": [
      "en",
      "fr"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dir"
      ],
      "identity": null,
      "category": "public.app-category.developer-tools"
    },
    "extraResources": [
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "gallery",
        "to": "gallery"
      },
      {
        "from": "fonts",
        "to": "fonts"
      },
      {
        "from": "templates-catalogue",
        "to": "templates-catalogue"
      },
      {
        "from": "out/hosts",
        "to": "hosts"
      }
    ]
  }
}

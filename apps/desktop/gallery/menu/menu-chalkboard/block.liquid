<section class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="rounded-box border-4 border-double border-neutral-content/30 px-5 py-10 md:px-12 md:py-14">
      <div class="text-center">
        <p class="font-mono text-sm tracking-[0.3em] uppercase">Chalked up today</p>
        <h2 class="mt-3 font-mono text-3xl font-bold tracking-wide uppercase md:text-5xl">On the board</h2>
        <div class="mx-auto mt-5 w-24 border-t-2 border-dashed border-neutral-content/40" aria-hidden="true"></div>
      </div>
      <div class="mt-12 grid gap-x-12 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
        {% assign courses = "starters,mains,sides,desserts,pastries,drinks" | split: "," %}
        {% for course in courses %}
          {% assign dishes = data.menu | where: "course", course %}
          {% if dishes.size > 0 %}
            <div>
              <h3 class="border-b-2 border-dashed border-neutral-content/30 pb-2 font-mono text-lg font-bold tracking-widest uppercase">{% case course %}{% when "starters" %}Starters{% when "mains" %}Mains{% when "sides" %}Sides{% when "desserts" %}Desserts{% when "pastries" %}Pastries{% else %}Drinks{% endcase %}</h3>
              <ul class="mt-5 space-y-5">
                {% for item in dishes %}
                  <li>
                    <div class="flex items-baseline justify-between gap-4 font-mono">
                      <h4 class="font-semibold uppercase">{{ item.name }}</h4>
                      {% if item.price %}<span class="font-bold whitespace-nowrap">{{ item.price }}</span>{% endif %}
                    </div>
                    {% if item.description %}<p class="mt-1 text-sm text-pretty italic">{{ item.description }}</p>{% endif %}
                    {% if item.tags.size > 0 %}
                      <div class="mt-2 flex flex-wrap gap-1.5">
                        {% for tag in item.tags %}<span class="badge badge-outline badge-sm">{{ tag }}</span>{% endfor %}
                      </div>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <p class="mt-12 text-center font-mono text-sm">Ask your server about today's specials and any allergies.</p>
    </div>
  </div>
</section>

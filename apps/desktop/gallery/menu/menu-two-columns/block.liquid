<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="grid gap-4 md:grid-cols-2 md:items-end md:gap-12">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">What we are cooking</h2>
      <p class="text-lg text-pretty text-base-content/70">A short menu that changes with the market. Everything is made in our kitchen, from the stocks to the desserts.</p>
    </div>
    <div class="mt-12 gap-6 md:columns-2">
      {% assign courses = "starters,mains,sides,desserts,pastries,drinks" | split: "," %}
      {% for course in courses %}
        {% assign dishes = data.menu | where: "course", course %}
        {% if dishes.size > 0 %}
          <div class="mb-6 break-inside-avoid rounded-box border border-base-300 bg-base-100 p-6 md:p-8">
            <h3 class="border-b border-base-300 pb-3 text-sm font-bold tracking-widest uppercase">{% case course %}{% when "starters" %}Starters{% when "mains" %}Mains{% when "sides" %}Sides{% when "desserts" %}Desserts{% when "pastries" %}Pastries{% else %}Drinks{% endcase %}</h3>
            <ul class="divide-y divide-base-300">
              {% for item in dishes %}
                <li class="py-4 last:pb-0">
                  <div class="flex items-baseline justify-between gap-4">
                    <h4 class="font-semibold">{{ item.name }}</h4>
                    {% if item.price %}<span class="font-semibold whitespace-nowrap tabular-nums">{{ item.price }}</span>{% endif %}
                  </div>
                  {% if item.description %}<p class="mt-1 text-sm text-pretty text-base-content/70">{{ item.description }}</p>{% endif %}
                  {% if item.tags.size > 0 %}
                    <div class="mt-2 flex flex-wrap gap-1.5">
                      {% for tag in item.tags %}<span class="badge badge-outline badge-sm">{{ tag }}</span>{% endfor %}
                    </div>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-2xl px-4 py-16 md:py-24">
    <div class="text-center">
      <p class="text-sm font-semibold tracking-[0.3em] uppercase text-base-content/70">Tasting menu</p>
      <h2 class="mt-3 font-serif text-4xl font-bold text-balance md:text-5xl">A seasonal journey</h2>
      <p class="mt-4 text-pretty text-base-content/70">A set sequence of small plates, served to the whole table and changed with each season.</p>
    </div>
    <ol class="mt-14 space-y-10 text-center">
      {% for item in data.tasting %}
        <li>
          <p class="font-serif text-sm tracking-widest text-base-content/70">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</p>
          <h3 class="mt-1 font-serif text-2xl font-semibold text-balance">{{ item.name }}</h3>
          {% if item.description %}<p class="mx-auto mt-2 max-w-md text-pretty text-base-content/70">{{ item.description }}</p>{% endif %}
          {% if item.tags.size > 0 %}
            <div class="mt-3 flex flex-wrap justify-center gap-1.5">
              {% for tag in item.tags %}<span class="badge badge-outline badge-sm">{{ tag }}</span>{% endfor %}
            </div>
          {% endif %}
          {% unless forloop.last %}<div class="mx-auto mt-10 h-px w-12 bg-base-content/30" aria-hidden="true"></div>{% endunless %}
        </li>
      {% endfor %}
    </ol>
    <div class="mt-16 rounded-box border border-base-300 bg-base-100 p-8 text-center">
      <p class="font-serif text-4xl font-bold">68 <span class="text-lg font-normal text-base-content/70">per guest</span></p>
      <p class="mt-2 text-base-content/70">Wine pairing, 35 more per guest</p>
      <p class="mx-auto mt-4 max-w-sm text-sm text-pretty text-base-content/70">Served Thursday to Saturday evenings. Tell us about any allergies when you book and we will adapt the menu.</p>
      <a href="/contact" class="btn btn-primary mt-6">Book a table</a>
    </div>
  </div>
</section>

<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <div class="grid gap-6 lg:grid-cols-3">
      <div class="flex flex-col justify-between gap-8 rounded-box bg-primary p-8 text-primary-content">
        <div>
          <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v2"/><path d="M14 2v2"/><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"/><path d="M6 2v2"/></svg>
          <h2 class="mt-6 text-3xl font-bold text-balance">Coffee and bakes</h2>
          <p class="mt-3 text-pretty">Pastries from our oven every morning, coffee roasted nearby, and milk of your choice.</p>
        </div>
        <div class="space-y-1 text-sm">
          <p class="font-semibold">Monday to Saturday, 7 am to 4 pm</p>
          <p>Sunday, 8 am to 1 pm</p>
        </div>
      </div>
      <div class="grid gap-6 rounded-box bg-base-100 p-6 sm:grid-cols-2 md:p-8 lg:col-span-2">
        {% assign courses = "drinks,pastries,starters,mains,sides,desserts" | split: "," %}
        {% for course in courses %}
          {% assign dishes = data.menu | where: "course", course %}
          {% if dishes.size > 0 %}
            <div>
              <h3 class="text-xs font-bold tracking-widest uppercase text-base-content/70">{% case course %}{% when "starters" %}Starters{% when "mains" %}Mains{% when "sides" %}Sides{% when "desserts" %}Desserts{% when "pastries" %}Pastries{% else %}Drinks{% endcase %}</h3>
              <ul class="mt-3 divide-y divide-dashed divide-base-300">
                {% for item in dishes %}
                  <li class="py-2.5">
                    <div class="flex items-baseline justify-between gap-3">
                      <h4 class="text-sm font-semibold">{{ item.name }}</h4>
                      {% if item.price %}<span class="text-sm font-semibold whitespace-nowrap tabular-nums">{{ item.price }}</span>{% endif %}
                    </div>
                    {% if item.description %}<p class="mt-0.5 text-xs text-pretty text-base-content/70">{{ item.description }}</p>{% endif %}
                    {% if item.tags.size > 0 %}
                      <div class="mt-1.5 flex flex-wrap gap-1">
                        {% for tag in item.tags %}<span class="badge badge-outline badge-sm">{{ tag }}</span>{% endfor %}
                      </div>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

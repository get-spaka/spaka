<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-2xl px-4 py-16 md:py-24">
    <div class="text-center">
      <p class="text-sm font-semibold tracking-widest uppercase text-base-content/70">À la carte</p>
      <h2 class="mt-2 font-serif text-3xl font-bold text-balance md:text-5xl">Our menu</h2>
      <p class="mt-4 text-pretty text-base-content/70">Cooked to order from what the season brings. Ask us about allergies, we are happy to adapt a dish.</p>
    </div>
    {% assign courses = "starters,mains,sides,desserts,pastries,drinks" | split: "," %}
    {% for course in courses %}
      {% assign dishes = data.menu | where: "course", course %}
      {% if dishes.size > 0 %}
        <div class="mt-14">
          <div class="flex items-center gap-4">
            <span class="h-px flex-1 bg-base-300" aria-hidden="true"></span>
            <h3 class="font-serif text-xl font-semibold tracking-wide italic md:text-2xl">{% case course %}{% when "starters" %}Starters{% when "mains" %}Mains{% when "sides" %}Sides{% when "desserts" %}Desserts{% when "pastries" %}Pastries{% else %}Drinks{% endcase %}</h3>
            <span class="h-px flex-1 bg-base-300" aria-hidden="true"></span>
          </div>
          <ul class="mt-8 space-y-6">
            {% for item in dishes %}
              <li>
                <div class="flex items-end">
                  <h4 class="text-lg font-semibold">{{ item.name }}</h4>
                  <span class="mx-3 mb-1.5 min-w-6 flex-1 border-b-2 border-dotted border-base-content/30" aria-hidden="true"></span>
                  {% if item.price %}<span class="text-lg font-semibold whitespace-nowrap">{{ item.price }}</span>{% endif %}
                </div>
                {% if item.description %}<p class="mt-1 text-sm text-pretty text-base-content/70">{{ item.description }}</p>{% endif %}
                {% if item.tags.size > 0 %}
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {% for tag in item.tags %}<span class="badge badge-outline badge-sm">{{ tag }}</span>{% endfor %}
                  </div>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold tracking-widest uppercase text-base-content/70">From our kitchen</p>
        <h2 class="mt-2 text-3xl font-bold text-balance md:text-4xl">Our favorite dishes</h2>
      </div>
      <a href="/contact" class="btn btn-primary self-start sm:self-auto">Book a table</a>
    </div>
    <ul class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {% for item in data.menu %}
        <li>
          {% if item.image %}
            <img src="{{ item.image }}" alt="{{ item.name }}" class="aspect-square w-full rounded-box object-cover">
          {% else %}
            <div class="flex aspect-square w-full items-center justify-center rounded-box bg-linear-to-br from-primary/20 to-accent/20 text-primary">
              <svg class="size-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
            </div>
          {% endif %}
          <div class="mt-4">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-lg font-semibold">{{ item.name }}</h3>
              {% if item.price %}<span class="text-lg font-semibold whitespace-nowrap tabular-nums">{{ item.price }}</span>{% endif %}
            </div>
            {% if item.description %}<p class="mt-1 text-sm text-pretty text-base-content/70">{{ item.description }}</p>{% endif %}
            {% if item.tags.size > 0 %}
              <div class="mt-3 flex flex-wrap gap-1.5">
                {% for tag in item.tags %}<span class="badge badge-outline badge-sm">{{ tag }}</span>{% endfor %}
              </div>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

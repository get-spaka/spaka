<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-4xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold tracking-wider text-base-content/70 uppercase">Our history</p>
      <h2 class="mt-3 text-3xl font-bold text-balance md:text-4xl">How we got here</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">A few of the moments that made us who we are, from the very first day to today.</p>
    </div>
    <ul class="timeline timeline-snap-icon timeline-vertical mt-12 max-md:timeline-compact">
      {% for milestone in data.milestones %}
        {% assign side = forloop.index0 | modulo: 2 %}
        <li>
          {% unless forloop.first %}<hr class="bg-base-300">{% endunless %}
          <div class="timeline-middle text-primary">
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="8"/></svg>
          </div>
          <div class="{% if side == 0 %}timeline-start md:text-end{% else %}timeline-end{% endif %} mb-10">
            {% if milestone.year != blank %}<p class="font-mono text-sm font-semibold text-base-content/70">{{ milestone.year }}</p>{% endif %}
            <h3 class="mt-1 text-lg font-bold">{{ milestone.title }}</h3>
            {% if milestone.text != blank %}<p class="mt-1 text-pretty text-base-content/70">{{ milestone.text }}</p>{% endif %}
          </div>
          {% unless forloop.last %}<hr class="bg-base-300">{% endunless %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

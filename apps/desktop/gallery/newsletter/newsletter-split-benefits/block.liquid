<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-2 md:items-center md:gap-16 md:py-24">
    <div>
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Get our letter, straight to your inbox</h2>
      <p class="mt-4 text-pretty text-base-content/70">A friendly note from Your business every few weeks: what is new, what is coming and what we are working on behind the counter.</p>
      <ul class="mt-8 space-y-5">
        <li class="flex gap-4">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-box bg-primary text-primary-content">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12v10H4V12"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
          </span>
          <div>
            <h3 class="font-semibold">Offers for subscribers</h3>
            <p class="mt-1 text-sm text-base-content/70">Small thank-yous that we only share by email.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-box bg-primary text-primary-content">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
          </span>
          <div>
            <h3 class="font-semibold">Dates before anyone else</h3>
            <p class="mt-1 text-sm text-base-content/70">Workshops, events and holiday hours, early enough to plan.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-box bg-primary text-primary-content">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 6v6l4 2"/></svg>
          </span>
          <div>
            <h3 class="font-semibold">A two-minute read</h3>
            <p class="mt-1 text-sm text-base-content/70">Short and useful, never more than one email a month.</p>
          </div>
        </li>
      </ul>
    </div>
    <div class="card border border-base-300 bg-base-200">
      <form hx-post="/_data/newsletter" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#newsletter-split-benefits-problems swap:innerHTML" class="card-body gap-4">
        <h3 class="card-title text-xl">Join the newsletter</h3>
        <fieldset class="fieldset">
          <label class="fieldset-legend" for="newsletter-split-benefits-name">First name</label>
          <input id="newsletter-split-benefits-name" name="name" type="text" maxlength="200" autocomplete="given-name" placeholder="Sam" class="input w-full" />
        </fieldset>
        <fieldset class="fieldset">
          <label class="fieldset-legend" for="newsletter-split-benefits-email">Email address</label>
          <input id="newsletter-split-benefits-email" name="email" type="email" required maxlength="200" autocomplete="email" placeholder="you@example.com" class="input w-full" />
        </fieldset>
        <div id="newsletter-split-benefits-problems"></div>
        <button type="submit" class="btn btn-primary w-full">Subscribe</button>
        <p class="text-center text-sm text-base-content/70">You can unsubscribe at any time, with one click in any email.</p>
      </form>
    </div>
  </div>
</section>

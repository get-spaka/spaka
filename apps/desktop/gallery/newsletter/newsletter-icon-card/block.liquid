<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="card mx-auto max-w-md border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body items-center gap-4 p-8 text-center">
        <span class="flex size-12 items-center justify-center rounded-box bg-secondary text-secondary-content">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h8"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/><path d="M19 16v6"/><path d="M16 19h6"/></svg>
        </span>
        <h2 class="text-2xl font-bold text-balance">Our little letter</h2>
        <p class="text-pretty text-base-content/70">Seasonal news and gentle reminders from Your business. Written by us, read in a minute.</p>
        <form hx-post="/_data/newsletter" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#newsletter-icon-card-problems swap:innerHTML" class="mt-2 flex w-full flex-col gap-3 text-left">
          <label class="sr-only" for="newsletter-icon-card-email">Email address</label>
          <input id="newsletter-icon-card-email" name="email" type="email" required maxlength="200" autocomplete="email" placeholder="you@example.com" class="input w-full" />
          <div id="newsletter-icon-card-problems"></div>
          <button type="submit" class="btn btn-secondary w-full">Send me the letter</button>
        </form>
        <p class="text-xs text-base-content/70">One email a month. Unsubscribe at any time.</p>
      </div>
    </div>
  </div>
</section>

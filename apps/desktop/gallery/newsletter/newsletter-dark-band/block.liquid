<section class="bg-neutral text-neutral-content">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-14 md:flex-row md:items-center md:justify-between md:py-20">
    <div class="max-w-xl">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">News from the workshop, once a month</h2>
      <p class="mt-3 text-pretty text-neutral-content">What we made, what we learned and what is next. Leave your email and we will write to you.</p>
    </div>
    <form hx-post="/_data/newsletter" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#newsletter-dark-band-problems swap:innerHTML" class="w-full md:max-w-md">
      <div class="flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="newsletter-dark-band-email">Email address</label>
        <input id="newsletter-dark-band-email" name="email" type="email" required maxlength="200" autocomplete="email" placeholder="you@example.com" class="input w-full text-base-content" />
        <button type="submit" class="btn btn-primary">Count me in</button>
      </div>
      <div id="newsletter-dark-band-problems" class="mt-3"></div>
      <p class="mt-3 text-sm text-neutral-content">No spam. Unsubscribe at any time.</p>
    </form>
  </div>
</section>

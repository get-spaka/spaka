<section class="bg-linear-to-br from-primary/10 to-accent/10 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold tracking-widest text-base-content/70 uppercase">Newsletter</p>
      <h2 class="mt-3 text-3xl font-bold text-balance md:text-5xl">Be the first to hear our news</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">New arrivals, seasonal opening hours and the occasional offer for subscribers, sent once a month.</p>
      <form hx-post="/_data/newsletter" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#newsletter-centered-join-problems swap:innerHTML" class="mx-auto mt-8 max-w-lg text-left">
        <div class="join w-full shadow-sm">
          <label class="sr-only" for="newsletter-centered-join-email">Email address</label>
          <input id="newsletter-centered-join-email" name="email" type="email" required maxlength="200" autocomplete="email" placeholder="you@example.com" class="input input-lg join-item w-full" />
          <button type="submit" class="btn btn-primary btn-lg join-item">Sign up</button>
        </div>
        <div id="newsletter-centered-join-problems" class="mt-3"></div>
      </form>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-base-content/70">
        <li class="flex items-center gap-2">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          One email a month
        </li>
        <li class="flex items-center gap-2">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          No spam, ever
        </li>
        <li class="flex items-center gap-2">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          Unsubscribe at any time
        </li>
      </ul>
    </div>
  </div>
</section>

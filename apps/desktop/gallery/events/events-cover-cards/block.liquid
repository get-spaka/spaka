<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold text-balance md:text-4xl">Workshops and events</h2>
        <p class="mt-4 text-lg text-pretty text-base-content/70">Learn something new, taste something good or simply spend an evening with us.</p>
      </div>
      <a href="/contact" class="btn btn-outline self-start md:self-auto">Ask about private events</a>
    </div>
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {% for event in data.events %}
        <article class="card overflow-hidden bg-base-100 shadow-sm">
          <a href="/events/{{ event.id }}" class="block" aria-label="{{ event.title }}">
            {% if event.cover %}
              <img src="{{ event.cover }}" alt="{{ event.title }}" class="aspect-3/2 w-full object-cover">
            {% else %}
              <div class="flex aspect-3/2 w-full items-center justify-center bg-linear-to-br from-primary/25 via-secondary/15 to-accent/25 text-base-content/60">
                <svg class="size-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
              </div>
            {% endif %}
          </a>
          <div class="card-body gap-3">
            <p class="text-sm font-semibold text-base-content/70">
              {% if event.date %}{{ event.date | date: "%a %-d %b %Y" }}{% endif %}{% if event.date and event.time %} · {% endif %}{% if event.time %}{{ event.time }}{% endif %}
            </p>
            <h3 class="card-title text-xl"><a href="/events/{{ event.id }}" class="link link-hover">{{ event.title }}</a></h3>
            {% if event.summary %}<p class="text-pretty text-base-content/70">{{ event.summary }}</p>{% endif %}
            {% if event.place %}
              <p class="inline-flex items-center gap-1.5 text-sm text-base-content/70"><svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>{{ event.place }}</p>
            {% endif %}
            <div class="card-actions mt-auto items-center justify-between pt-3">
              {% if event.price %}<span class="text-lg font-bold">{{ event.price }}</span>{% else %}<span></span>{% endif %}
              {% if event.booking %}
                <a href="{{ event.booking }}" class="btn btn-primary btn-sm">Book</a>
              {% else %}
                <a href="/events/{{ event.id }}" class="btn btn-ghost btn-sm">Details</a>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

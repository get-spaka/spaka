<article class="bg-base-100 text-base-content">
  {% if record.cover %}
    <img src="{{ record.cover }}" alt="{{ record.title }}" class="aspect-video max-h-[28rem] w-full object-cover">
  {% else %}
    <div class="flex h-48 w-full items-center justify-center bg-linear-to-br from-primary/25 via-secondary/15 to-accent/25 text-base-content/60 md:h-64">
      <svg class="size-14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
    </div>
  {% endif %}
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-12 md:py-16 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <h1 class="text-3xl font-bold text-balance md:text-5xl">{{ record.title }}</h1>
      {% if record.summary %}<p class="mt-4 text-xl text-pretty text-base-content/70">{{ record.summary }}</p>{% endif %}
      <div class="mt-8 space-y-4 text-lg text-pretty [&_h2]:pt-4 [&_h2]:text-2xl [&_h2]:font-bold [&_h3]:pt-2 [&_h3]:text-xl [&_h3]:font-semibold [&_a]:link [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6">{{ record.body }}</div>
    </div>
    <aside class="card h-fit bg-base-200">
      <div class="card-body gap-4">
        {% if record.date %}
          <div class="flex gap-3"><svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg><div><p class="text-sm text-base-content/70">Date</p><p class="font-semibold">{{ record.date | date: "%A %-d %B %Y" }}</p></div></div>
        {% endif %}
        {% if record.time %}
          <div class="flex gap-3"><svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><div><p class="text-sm text-base-content/70">Time</p><p class="font-semibold">{{ record.time }}</p></div></div>
        {% endif %}
        {% if record.place %}
          <div class="flex gap-3"><svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg><div><p class="text-sm text-base-content/70">Place</p><p class="font-semibold">{{ record.place }}</p></div></div>
        {% endif %}
        {% if record.price %}
          <div class="flex gap-3"><svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg><div><p class="text-sm text-base-content/70">Price</p><p class="font-semibold">{{ record.price }}</p></div></div>
        {% endif %}
        {% if record.booking %}<a href="{{ record.booking }}" class="btn btn-primary btn-block mt-2">Book your place</a>{% endif %}
      </div>
    </aside>
  </div>
</article>

<article class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-3xl px-4 py-16 md:py-24">
    <div class="text-center">
      {% if record.date %}
        <p class="text-sm font-semibold tracking-widest uppercase text-base-content/70">{{ record.date | date: "%B %Y" }}</p>
        <span class="mx-auto mt-4 flex size-16 items-center justify-center rounded-full bg-primary text-2xl font-bold text-primary-content">{{ record.date | date: "%-d" }}</span>
      {% endif %}
      <h1 class="mt-6 text-3xl font-bold text-balance md:text-5xl">{{ record.title }}</h1>
      {% if record.summary %}<p class="mx-auto mt-4 max-w-2xl text-lg text-pretty text-base-content/70">{{ record.summary }}</p>{% endif %}
      <ul class="mt-8 flex flex-wrap justify-center gap-3">
        {% if record.date %}<li class="badge badge-lg badge-outline">{{ record.date | date: "%A %-d %B %Y" }}</li>{% endif %}
        {% if record.time %}<li class="badge badge-lg badge-outline">{{ record.time }}</li>{% endif %}
        {% if record.place %}<li class="badge badge-lg badge-outline">{{ record.place }}</li>{% endif %}
        {% if record.price %}<li class="badge badge-lg badge-outline">{{ record.price }}</li>{% endif %}
      </ul>
      {% if record.booking %}<a href="{{ record.booking }}" class="btn btn-primary mt-8">Book a place</a>{% endif %}
    </div>
    {% if record.cover %}<img src="{{ record.cover }}" alt="{{ record.title }}" class="mt-12 aspect-video w-full rounded-box object-cover">{% endif %}
    <div class="mt-12 space-y-4 border-t border-base-300 pt-10 text-lg text-pretty [&_h2]:pt-4 [&_h2]:text-2xl [&_h2]:font-bold [&_h3]:pt-2 [&_h3]:text-xl [&_h3]:font-semibold [&_a]:link [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6">{{ record.body }}</div>
  </div>
</article>

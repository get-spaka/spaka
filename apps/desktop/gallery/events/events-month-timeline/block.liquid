<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-4xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Our year of events</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">Month by month, everything we have planned. Save the dates.</p>
    </div>
    {% assign shown_month = "" %}
    <ul class="timeline timeline-vertical mt-12 max-md:timeline-compact">
      {% for event in data.events %}
        {% assign month = event.date | date: "%B %Y" %}
        <li>
          {% unless forloop.first %}<hr class="bg-base-300">{% endunless %}
          <div class="timeline-start mb-3 md:mb-10 md:pt-1 md:text-end">
            {% if month != shown_month %}<p class="text-lg font-bold">{{ month }}</p>{% endif %}
          </div>
          <div class="timeline-middle">
            <span class="flex size-8 items-center justify-center rounded-full bg-primary text-sm font-bold text-primary-content">{% if event.date %}{{ event.date | date: "%-d" }}{% endif %}</span>
          </div>
          <div class="timeline-end mb-10 w-full">
            <article class="rounded-box border border-base-300 bg-base-100 p-5">
              <p class="text-sm font-semibold text-base-content/70">{% if event.date %}{{ event.date | date: "%A %-d %B" }}{% endif %}{% if event.date and event.time %} · {% endif %}{{ event.time }}</p>
              <h3 class="mt-1 text-xl font-semibold"><a href="/events/{{ event.id }}" class="link link-hover">{{ event.title }}</a></h3>
              {% if event.summary %}<p class="mt-2 text-pretty text-base-content/70">{{ event.summary }}</p>{% endif %}
              <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
                {% if event.place %}<span class="text-base-content/70">{{ event.place }}</span>{% endif %}
                {% if event.price %}<span class="font-semibold">{{ event.price }}</span>{% endif %}
                {% if event.booking %}<a href="{{ event.booking }}" class="link link-hover font-semibold">Book</a>{% endif %}
              </div>
            </article>
          </div>
          {% unless forloop.last %}<hr class="bg-base-300">{% endunless %}
        </li>
        {% assign shown_month = month %}
      {% endfor %}
    </ul>
  </div>
</section>

<section class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <h2 class="text-5xl font-black tracking-tight uppercase md:text-7xl">What's on</h2>
      <p class="max-w-sm text-lg text-pretty text-neutral-content">Evenings, tastings and gatherings. Pick a date and come and see us.</p>
    </div>
    <ul class="mt-12 border-t border-neutral-content/25">
      {% for event in data.events %}
        <li class="grid gap-4 border-b border-neutral-content/25 py-8 md:grid-cols-12 md:items-center md:gap-6">
          <div class="flex items-baseline gap-3 md:col-span-3 md:flex-col md:gap-1">
            {% if event.date %}
              <span class="text-4xl leading-none font-black md:text-5xl">{{ event.date | date: "%-d %b" }}</span>
              <span class="text-sm font-semibold tracking-widest uppercase text-neutral-content">{{ event.date | date: "%A" }}</span>
            {% else %}
              <span class="text-2xl font-black">Date to come</span>
            {% endif %}
          </div>
          <div class="md:col-span-6">
            <h3 class="text-2xl font-bold text-balance md:text-3xl"><a href="/events/{{ event.id }}" class="link link-hover">{{ event.title }}</a></h3>
            {% if event.time or event.place %}
              <p class="mt-2 text-neutral-content">{{ event.time }}{% if event.time and event.place %} · {% endif %}{{ event.place }}</p>
            {% endif %}
          </div>
          <div class="flex items-center gap-4 md:col-span-3 md:justify-end">
            {% if event.price %}<span class="text-lg font-semibold">{{ event.price }}</span>{% endif %}
            {% if event.booking %}
              <a href="{{ event.booking }}" class="btn btn-primary">Tickets</a>
            {% else %}
              <a href="/events/{{ event.id }}" class="btn btn-outline border-neutral-content/40 text-neutral-content hover:bg-neutral-content hover:text-neutral">Details</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

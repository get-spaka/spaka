<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Good to know</h2>
      <p class="mt-4 text-lg text-base-content/70">Answers to the questions we hear most often.</p>
    </div>
    <div class="mt-12 grid gap-x-12 gap-y-10 md:grid-cols-2">
      {% for item in data.faq %}
      <div class="flex gap-4">
        <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-secondary text-secondary-content">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
        </div>
        <div>
          <h3 class="text-lg font-semibold">{{ item.question }}</h3>
          <div class="mt-2 space-y-2 text-base-content/70">{{ item.answer }}</div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

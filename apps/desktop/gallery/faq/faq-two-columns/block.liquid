<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 md:grid-cols-3 md:py-24">
    <div>
      <h2 class="text-3xl font-bold text-balance">Questions and answers</h2>
      <p class="mt-4 text-base-content/70">Everything you need to know before you start. Still unsure? We are happy to help.</p>
      <a href="#" class="btn btn-primary mt-6">Contact us</a>
    </div>
    <div class="divide-y divide-base-300 md:col-span-2">
      {% for item in data.faq %}
      <details class="collapse collapse-plus rounded-none" {% if forloop.first %}open{% endif %}>
        <summary class="collapse-title px-0 text-lg font-semibold">{{ item.question }}</summary>
        <div class="collapse-content space-y-2 px-0 text-base-content/70">{{ item.answer }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

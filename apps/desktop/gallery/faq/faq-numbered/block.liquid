<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-3xl px-4 py-16 md:py-24">
    <p class="text-sm font-semibold tracking-widest uppercase text-base-content/70">Practical information</p>
    <h2 class="mt-2 font-serif text-3xl font-semibold text-balance md:text-4xl">Good to know before you visit</h2>
    <ol class="mt-10 border-t border-base-content/20">
      {% for item in data.faq %}
        <li class="border-b border-base-content/20">
          <details class="group">
            <summary class="flex cursor-pointer list-none items-baseline gap-4 py-4 md:gap-6 [&::-webkit-details-marker]:hidden">
              <span class="w-8 shrink-0 font-serif text-lg tabular-nums text-base-content/70">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              <span class="flex-1 font-serif text-lg font-medium md:text-xl">{{ item.question }}</span>
              <svg class="size-4 shrink-0 self-center text-base-content/70 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="space-y-2 pb-5 pl-12 text-pretty text-base-content/70 md:pl-14 md:pr-10 [&_a]:link [&_ol]:list-decimal [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:pl-5">{{ item.answer }}</div>
          </details>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

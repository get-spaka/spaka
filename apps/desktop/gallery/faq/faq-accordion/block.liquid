<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Frequently asked questions</h2>
      <p class="mt-4 text-lg text-base-content/70">Can’t find what you are looking for? <a href="#" class="link link-primary">Get in touch</a>.</p>
    </div>
    <div class="mx-auto mt-12 max-w-3xl space-y-3">
      {% for item in data.faq %}
      <div class="collapse collapse-arrow rounded-box bg-base-200">
        <input type="radio" name="faq-accordion" id="faq-accordion-{{ forloop.index }}" {% if forloop.first %}checked{% endif %} />
        <div class="collapse-title font-semibold">{{ item.question }}</div>
        <div class="collapse-content space-y-2 text-base-content/70">{{ item.answer }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

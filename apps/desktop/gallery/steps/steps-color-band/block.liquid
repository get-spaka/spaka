<section class="bg-secondary text-secondary-content">
  <div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 py-12 md:py-14 lg:flex-row lg:items-center lg:gap-16">
    <h2 class="text-2xl font-bold text-balance md:text-3xl lg:max-w-56">Booking takes a minute</h2>
    <ol class="flex flex-1 flex-col gap-6 md:flex-row md:items-start md:gap-4">
      {% for step in data.steps %}
        <li class="flex flex-1 items-start gap-4">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-full border-2 border-secondary-content font-bold">{{ forloop.index }}</span>
          <div class="flex-1">
            <h3 class="font-semibold">{{ step.title }}</h3>
            {% if step.text != blank %}<p class="mt-1 text-sm text-pretty text-secondary-content">{{ step.text }}</p>{% endif %}
          </div>
          {% unless forloop.last %}<svg class="mt-2 hidden size-6 shrink-0 md:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>{% endunless %}
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

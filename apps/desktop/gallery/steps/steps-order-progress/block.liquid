<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-5xl px-4 py-16 md:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">From your order to your door</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">Order before noon and most parcels leave the same day.</p>
    </div>
    <div class="mt-10 rounded-box border border-base-300 p-6 md:p-10">
      <ul class="steps steps-vertical w-full md:steps-horizontal">
        {% for step in data.steps %}
          <li class="step step-primary" data-content="{{ forloop.index }}">
            <div class="py-2 text-start md:px-2 md:text-center">
              <h3 class="font-semibold">{{ step.title }}</h3>
              {% if step.text != blank %}<p class="mt-1 text-sm text-pretty text-base-content/70">{{ step.text }}</p>{% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="border-b border-base-300 bg-base-200 text-base-content has-[:checked]:hidden">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2">
    <span class="hidden size-6 sm:block" aria-hidden="true"></span>
    <p class="text-center text-sm">
      No cookies and no tracking here<span class="hidden sm:inline">: your visit stays private</span>.
      <a href="#" class="inline-block font-semibold underline underline-offset-2">Our privacy note</a>
    </p>
    <label class="btn btn-ghost btn-square btn-xs shrink-0" title="Dismiss">
      <input type="checkbox" class="sr-only" aria-label="Dismiss this notice">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </label>
  </div>
</section>

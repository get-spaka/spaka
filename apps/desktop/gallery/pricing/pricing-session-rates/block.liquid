<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 md:py-24 lg:grid-cols-5 lg:gap-16">
    <div class="lg:col-span-2">
      <p class="text-sm font-semibold tracking-widest text-base-content/70 uppercase">Sessions and rates</p>
      <h2 class="mt-3 text-3xl font-bold text-balance md:text-4xl">Book the time you need</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">One-to-one sessions, online or at my studio. Start with a free call to see if we are a good fit.</p>
      <ul class="mt-8 space-y-4">
        <li class="flex items-start gap-3">
          <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-base-100 text-primary">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
          </span>
          <span class="pt-1.5">Online or in person, as you prefer</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-base-100 text-primary">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
          </span>
          <span class="pt-1.5">Move a session up to 24 hours before</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-base-100 text-primary">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M9 15h6"/><path d="M9 11h6"/></svg>
          </span>
          <span class="pt-1.5">Notes and exercises after every session</span>
        </li>
      </ul>
    </div>
    <ul class="divide-y divide-base-300 rounded-box bg-base-100 px-6 shadow-sm md:px-8 lg:col-span-3">
      {% for plan in data.plans %}
        <li class="py-6 sm:flex sm:items-start sm:justify-between sm:gap-6">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-lg font-semibold">{{ plan.name }}</h3>
              {% if plan.featured %}<span class="badge badge-accent badge-sm">Best value</span>{% endif %}
            </div>
            {% if plan.description %}<p class="mt-1 text-pretty text-base-content/70">{{ plan.description }}</p>{% endif %}
            {% if plan.features.size > 0 %}
              <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-base-content/70">
                {% for feature in plan.features %}
                  <li class="flex items-center gap-1.5">
                    <svg class="size-3.5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    <span>{{ feature }}</span>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
          <div class="mt-4 flex items-center justify-between gap-4 sm:mt-0 sm:flex-col sm:items-end sm:gap-3">
            <p class="whitespace-nowrap"><span class="text-2xl font-bold tabular-nums">{{ plan.price }}</span><span class="text-sm text-base-content/70">{{ plan.period }}</span></p>
            {% if plan.href %}<a href="{{ plan.href }}" class="btn btn-sm {% if plan.featured %}btn-primary{% else %}btn-outline{% endif %}">{{ plan.cta }}</a>{% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Simple, honest pricing</h2>
      <p class="mt-4 text-lg text-base-content/70">Pick the plan that suits you. Change it whenever you like.</p>
    </div>
    <div class="mx-auto mt-12 grid max-w-3xl gap-6 sm:grid-cols-2 sm:items-center">
      {% for plan in data.plans limit: 2 %}
      <div class="card {% if plan.featured %}border-2 border-primary shadow-lg{% else %}card-border border-base-300{% endif %} bg-base-100">
        <div class="card-body p-8 text-center">
          <h3 class="text-lg font-semibold">{{ plan.name }}</h3>
          <p class="mt-2"><span class="text-4xl font-bold">{{ plan.price }}</span><span class="text-base-content/70">{{ plan.period }}</span></p>
          <ul class="mt-6 space-y-3 text-left">
            {% for feature in plan.features %}
            <li class="flex items-center gap-3">
              <svg class="size-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              <span>{{ feature }}</span>
            </li>
            {% endfor %}
          </ul>
          <a href="{{ plan.href }}" class="btn {% if plan.featured %}btn-primary{% else %}btn-outline btn-primary{% endif %} mt-8">{{ plan.cta }}</a>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

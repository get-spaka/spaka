<section class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-7xl px-4 py-16 md:py-24 xl:flex xl:items-center xl:gap-12">
    <div class="mx-auto max-w-xl text-center xl:mx-0 xl:w-80 xl:shrink-0 xl:text-left">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Find your desk</h2>
      <div class="mt-4 flex items-center justify-center gap-1 xl:justify-start" aria-hidden="true">
        <span class="h-1 w-24 rounded-full bg-primary"></span>
        <span class="h-1 w-3 rounded-full bg-primary"></span>
        <span class="size-1 rounded-full bg-primary"></span>
      </div>
      <p class="mt-4 text-lg text-pretty">Fast wifi, good coffee and quiet rooms, five minutes from the station. Try a day before you commit.</p>
      <a href="/contact" class="mt-6 inline-flex items-center gap-2 font-semibold underline underline-offset-4">
        Book a visit
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
    <div class="mt-12 grid flex-1 gap-6 md:grid-cols-3 xl:mt-0">
      {% for plan in data.plans limit: 3 %}
        <div class="flex flex-col rounded-box {% if plan.featured %}bg-primary text-primary-content shadow-xl{% else %}border border-neutral-content/20{% endif %}">
          <div class="p-6">
            <h3 class="text-xl font-semibold">{{ plan.name }}</h3>
            {% if plan.description %}<p class="mt-3 text-pretty">{{ plan.description }}</p>{% endif %}
            <p class="mt-6"><span class="text-4xl font-bold tabular-nums">{{ plan.price }}</span><span class="font-medium">{{ plan.period }}</span></p>
            {% if plan.href %}<a href="{{ plan.href }}" class="btn {% if plan.featured %}btn-neutral{% else %}btn-primary{% endif %} mt-6 btn-block">{{ plan.cta }}</a>{% endif %}
          </div>
          <div class="flex-1 border-t p-6 {% if plan.featured %}border-primary-content/20{% else %}border-neutral-content/20{% endif %}">
            <p class="text-sm font-semibold tracking-wide uppercase">What’s included</p>
            <ul class="mt-4 space-y-3">
              {% for feature in plan.features %}
                <li class="flex items-center gap-3">
                  <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                  <span>{{ feature }}</span>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

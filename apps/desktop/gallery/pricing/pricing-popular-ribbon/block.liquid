<section class="bg-linear-to-b from-primary/10 to-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <span class="badge badge-primary">Memberships</span>
      <h2 class="mt-4 text-3xl font-bold text-balance md:text-4xl">Move at your own rhythm</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">Come once, or come every day. Every option includes mats, towels and a warm shower.</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {% for plan in data.plans limit: 4 %}
        <div class="flex flex-col overflow-hidden rounded-box bg-base-100 {% if plan.featured %}border-2 border-primary shadow-lg{% else %}border border-base-300{% endif %}">
          {% if plan.featured %}
            <p class="flex items-center justify-center gap-2 bg-primary py-2 text-sm font-semibold text-primary-content">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.5 2.3a.5.5 0 0 1 1 0l2.3 4.7 5.2.8a.5.5 0 0 1 .3.9l-3.8 3.6.9 5.2a.5.5 0 0 1-.7.5L12 15.6l-4.6 2.4a.5.5 0 0 1-.7-.5l.9-5.2-3.8-3.6a.5.5 0 0 1 .3-.9l5.2-.8Z"/></svg>
              Most popular
            </p>
          {% else %}
            <p class="invisible hidden py-2 text-sm font-semibold sm:block" aria-hidden="true">Most popular</p>
          {% endif %}
          <div class="flex flex-1 flex-col p-6">
            <h3 class="text-lg font-bold">{{ plan.name }}</h3>
            {% if plan.description %}<p class="mt-1 text-sm text-pretty text-base-content/70">{{ plan.description }}</p>{% endif %}
            <p class="mt-5"><span class="text-4xl font-bold tabular-nums">{{ plan.price }}</span><span class="text-base-content/70">{{ plan.period }}</span></p>
            <ul class="mt-6 flex-1 space-y-2 text-sm">
              {% for feature in plan.features %}
                <li class="flex items-start gap-2">
                  <svg class="mt-0.5 size-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  <span>{{ feature }}</span>
                </li>
              {% endfor %}
            </ul>
            {% if plan.href %}<a href="{{ plan.href }}" class="btn {% if plan.featured %}btn-primary{% else %}btn-soft btn-primary{% endif %} mt-6 btn-block">{{ plan.cta }}</a>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

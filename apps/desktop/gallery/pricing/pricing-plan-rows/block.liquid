<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-5xl px-4 py-16 md:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Care plans for your website</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">Updates, backups and small changes, handled every month. Switch plans or cancel whenever you like.</p>
    </div>
    <div class="mt-12 divide-y divide-base-300 overflow-hidden rounded-box border border-base-300">
      {% for plan in data.plans %}
        <div class="grid gap-6 p-6 md:grid-cols-12 md:items-center md:gap-8 md:p-8{% if plan.featured %} bg-base-200{% endif %}">
          <div class="md:col-span-4">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-xl font-bold">{{ plan.name }}</h3>
              {% if plan.featured %}<span class="badge badge-primary badge-sm">Recommended</span>{% endif %}
            </div>
            {% if plan.description %}<p class="mt-2 text-pretty text-base-content/70">{{ plan.description }}</p>{% endif %}
          </div>
          <ul class="grid gap-2 text-sm sm:grid-cols-2 md:col-span-5">
            {% for feature in plan.features %}
              <li class="flex items-start gap-2">
                <svg class="mt-0.5 size-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span>{{ feature }}</span>
              </li>
            {% endfor %}
          </ul>
          <div class="flex items-center justify-between gap-4 border-t border-base-300 pt-6 md:col-span-3 md:flex-col md:items-end md:border-0 md:pt-0">
            <p class="whitespace-nowrap"><span class="text-3xl font-bold tabular-nums">{{ plan.price }}</span><span class="text-base-content/70">{{ plan.period }}</span></p>
            {% if plan.href %}<a href="{{ plan.href }}" class="btn {% if plan.featured %}btn-primary{% else %}btn-outline{% endif %}">{{ plan.cta }}</a>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Plans for every stage</h2>
      <p class="mt-4 text-lg text-base-content/70">Start small and grow at your own pace. All plans include a 14-day free trial.</p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3 md:items-start">
      {% for plan in data.plans %}
      <div class="card {% if plan.featured %}bg-primary text-primary-content shadow-xl md:-mt-4{% else %}bg-base-100{% endif %}">
        <div class="card-body gap-0 p-8">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-xl font-bold">{{ plan.name }}</h3>
            {% if plan.featured %}<span class="badge badge-secondary">Most popular</span>{% endif %}
          </div>
          <p class="mt-2 {% if plan.featured %}opacity-90{% else %}text-base-content/70{% endif %}">{{ plan.description }}</p>
          <p class="mt-6"><span class="text-5xl font-bold">{{ plan.price }}</span><span class="{% if plan.featured %}opacity-90{% else %}text-base-content/70{% endif %}">{{ plan.period }}</span></p>
          <a href="{{ plan.href }}" class="btn {% if plan.featured %}btn-neutral{% else %}btn-primary{% endif %} mt-6 btn-block">{{ plan.cta }}</a>
          <ul class="mt-8 space-y-3">
            {% for feature in plan.features %}
            <li class="flex items-center gap-3">
              <svg class="size-5 shrink-0{% unless plan.featured %} text-primary{% endunless %}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              <span>{{ feature }}</span>
            </li>
            {% endfor %}
          </ul>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Your business in numbers</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">A few figures that show how we work, day after day.</p>
    </div>
    <div class="stats stats-vertical mt-12 w-full rounded-none border-y border-base-300 bg-transparent lg:stats-horizontal">
      {% for stat in data.stats %}
        <div class="stat px-2 py-8 lg:px-8">
          <p class="stat-title text-base-content/70">{{ stat.label }}</p>
          <p class="stat-value text-4xl md:text-5xl">{{ stat.value }}</p>
          {% if stat.note %}<p class="stat-desc mt-1 text-sm text-base-content/70">{{ stat.note }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

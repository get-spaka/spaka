<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-5xl px-4 py-16 text-center md:py-24">
    <h2 class="text-2xl font-light text-balance md:text-3xl">Care you can count on</h2>
    <p class="mx-auto mt-3 max-w-xl text-pretty text-base-content/70">A neighbourhood clinic with a long memory.</p>
    <dl class="mt-12 flex flex-wrap justify-center gap-x-16 gap-y-10">
      {% for stat in data.stats %}
        <div class="flex flex-col">
          <dt class="order-2 mt-3 text-xs font-medium uppercase tracking-widest text-base-content/70">{{ stat.label }}</dt>
          <dd class="order-1 text-5xl font-light tracking-tight md:text-6xl">{{ stat.value }}</dd>
          {% if stat.note %}<dd class="order-3 mt-1 text-sm text-base-content/70">{{ stat.note }}</dd>{% endif %}
        </div>
      {% endfor %}
    </dl>
  </div>
</section>

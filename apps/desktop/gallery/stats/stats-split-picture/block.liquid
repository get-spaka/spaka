<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 md:grid-cols-2 md:py-24">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-base-content/70">Our story</p>
      <h2 class="mt-2 text-3xl font-bold text-balance md:text-4xl">Fifteen years of gardens we are proud of</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">From small courtyards to family gardens, we design each one around the people who will live in it.</p>
      <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3">
        {% for stat in data.stats %}
          <div class="flex flex-col border-l-2 border-primary pl-4">
            <dt class="order-2 mt-1 text-sm font-medium text-base-content/70">{{ stat.label }}</dt>
            <dd class="order-1 text-3xl font-bold">{{ stat.value }}</dd>
            {% if stat.note %}<dd class="order-3 mt-1 text-xs text-base-content/70">{{ stat.note }}</dd>{% endif %}
          </div>
        {% endfor %}
      </dl>
    </div>
    <div class="flex aspect-4/3 items-center justify-center rounded-box bg-linear-to-br from-primary/20 to-accent/20 text-primary">
      <svg class="size-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.09-3.09a2 2 0 0 0-2.82 0L6 21"/></svg>
    </div>
  </div>
</section>

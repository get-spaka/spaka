<section class="bg-primary text-primary-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Trusted by our neighbours</h2>
      <p class="mt-4 text-lg text-pretty text-primary-content">Local, careful and on time, for almost ten years.</p>
    </div>
    <dl class="mt-12 flex flex-wrap justify-center gap-y-10 text-center">
      {% for stat in data.stats %}
        <div class="flex basis-1/2 flex-col px-4 lg:basis-0 lg:grow">
          <dt class="order-2 mt-2 font-medium text-primary-content">{{ stat.label }}</dt>
          <dd class="order-1 text-4xl font-extrabold md:text-5xl">{{ stat.value }}</dd>
          {% if stat.note %}<dd class="order-3 mt-1 text-sm text-primary-content">{{ stat.note }}</dd>{% endif %}
        </div>
      {% endfor %}
    </dl>
  </div>
</section>

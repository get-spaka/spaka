<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 md:py-24 lg:grid-cols-2">
    <div>
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Built properly, the first time</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">We are a family-run building company. The same team plans, builds and finishes your project, so nothing gets lost on the way.</p>
      <p class="mt-4 text-pretty text-base-content/70">Clear quotes, a fixed schedule and a tidy site at the end of every day.</p>
      <a href="/about" class="btn btn-primary mt-8">About us</a>
    </div>
    <dl class="grid gap-4 sm:grid-cols-2">
      {% for stat in data.stats %}
        <div class="flex flex-col rounded-box border border-base-300 bg-base-100 p-6">
          <dt class="order-2 mt-2 font-semibold">{{ stat.label }}</dt>
          <dd class="order-1 text-4xl font-extrabold">{{ stat.value }}</dd>
          {% if stat.note %}<dd class="order-3 mt-1 text-sm text-base-content/70">{{ stat.note }}</dd>{% endif %}
        </div>
      {% endfor %}
    </dl>
  </div>
</section>

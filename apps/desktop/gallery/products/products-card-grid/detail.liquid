<article class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-20">
    <a href="/products" class="link link-hover inline-flex items-center gap-1 text-sm text-base-content/70"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>All products</a>
    <div class="mt-6 grid gap-10 md:grid-cols-2 lg:gap-16">
      {% if record.image %}
        <img src="{{ record.image }}" alt="{{ record.name }}" class="aspect-square w-full rounded-box object-cover">
      {% else %}
        <div class="flex aspect-square w-full items-center justify-center rounded-box bg-linear-to-br from-primary/25 to-secondary/20 text-base-content/50">
          <svg class="size-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 10a4 4 0 0 1-8 0"/><path d="M3.103 6.034h17.794"/><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"/></svg>
        </div>
      {% endif %}
      <div>
        {% if record.category or record.badge or record.available == false %}
          <div class="flex flex-wrap items-center gap-2 text-sm">
            {% if record.category %}<span class="text-base-content/70">{{ record.category }}</span>{% endif %}
            {% if record.badge %}<span class="badge badge-secondary">{{ record.badge }}</span>{% endif %}
            {% if record.available == false %}<span class="badge badge-outline">Sold out</span>{% endif %}
          </div>
        {% endif %}
        <h1 class="mt-3 text-3xl font-bold text-balance md:text-5xl">{{ record.name }}</h1>
        {% if record.price %}<p class="mt-4 text-2xl font-semibold tabular-nums">{{ record.price }}</p>{% endif %}
        {% if record.summary %}<p class="mt-4 text-lg text-pretty text-base-content/70">{{ record.summary }}</p>{% endif %}
        <div class="mt-8 flex flex-wrap gap-3">
          {% if record.available == false %}
            <a href="/contact" class="btn btn-outline">Ask when it's back</a>
          {% elsif record.order_link %}
            <a href="{{ record.order_link }}" class="btn btn-primary">Order</a>
            <a href="/contact" class="btn btn-ghost">Ask a question</a>
          {% else %}
            <a href="/contact" class="btn btn-primary">Order by message</a>
          {% endif %}
        </div>
        <div class="mt-10 border-t border-base-300 pt-8 text-lg leading-relaxed [&_a]:link [&_a]:link-primary [&_h2]:mt-8 [&_h2]:text-2xl [&_h2]:font-bold [&_h2:first-child]:mt-0 [&_h3]:mt-6 [&_h3]:text-xl [&_h3]:font-semibold [&_li]:mt-1 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mt-4 [&_p:first-child]:mt-0 [&_strong]:font-semibold [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">{{ record.body }}</div>
      </div>
    </div>
    <div class="mt-20">
      <h2 class="text-2xl font-bold">You may also like</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% assign shown = 0 %}
        {% for product in data.products %}
          {% if product.id != record.id and shown < 3 %}
            {% assign shown = shown | plus: 1 %}
            {% assign tint = shown | modulo: 3 %}
            <a href="/products/{{ product.id }}" class="group flex items-center gap-4 rounded-box border border-base-300 p-3">
              {% if product.image %}
                <img src="{{ product.image }}" alt="{{ product.name }}" class="size-20 shrink-0 rounded-field object-cover">
              {% else %}
                <div class="flex size-20 shrink-0 items-center justify-center rounded-field bg-linear-to-br text-base-content/50 {% if tint == 0 %}from-primary/25 to-secondary/20{% elsif tint == 1 %}from-secondary/25 to-accent/20{% else %}from-accent/25 to-primary/20{% endif %}">
                  <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 10a4 4 0 0 1-8 0"/><path d="M3.103 6.034h17.794"/><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"/></svg>
                </div>
              {% endif %}
              <div class="min-w-0">
                <p class="font-semibold group-hover:underline">{{ product.name }}</p>
                {% if product.price %}<p class="mt-1 text-sm tabular-nums text-base-content/70">{{ product.price }}</p>{% endif %}
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</article>

<article class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-2 md:py-20 lg:gap-20 lg:px-8">
    {% if record.image %}
      <img src="{{ record.image }}" alt="{{ record.name }}" class="aspect-3/4 w-full object-cover">
    {% else %}
      <div class="flex aspect-3/4 w-full items-center justify-center bg-linear-to-b from-base-200 to-primary/20 text-base-content/40">
        <svg class="size-14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
      </div>
    {% endif %}
    <div class="md:py-8">
      {% if record.category %}<p class="text-sm tracking-wider uppercase text-base-content/70">{{ record.category }}</p>{% endif %}
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-balance md:text-4xl">{{ record.name }}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        {% if record.price %}<p class="text-xl tracking-wider tabular-nums">{{ record.price }}</p>{% endif %}
        {% if record.badge %}<span class="badge badge-ghost">{{ record.badge }}</span>{% endif %}
        {% if record.available == false %}<span class="text-sm text-base-content/70">Sold out</span>{% endif %}
      </div>
      {% if record.summary %}<p class="mt-6 text-pretty text-base-content/70">{{ record.summary }}</p>{% endif %}
      <div class="mt-8">
        {% if record.available == false %}
          <a href="/contact" class="btn btn-outline btn-block sm:btn-wide">Ask when it's back</a>
        {% elsif record.order_link %}
          <a href="{{ record.order_link }}" class="btn btn-neutral btn-block sm:btn-wide">Order</a>
        {% else %}
          <a href="/contact" class="btn btn-neutral btn-block sm:btn-wide">Order by message</a>
        {% endif %}
      </div>
      <div class="mt-10 border-t border-base-300 pt-8 leading-relaxed text-base-content/80 [&_a]:link [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-semibold [&_h2:first-child]:mt-0 [&_h3]:mt-6 [&_h3]:font-semibold [&_li]:mt-1 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mt-4 [&_p:first-child]:mt-0 [&_strong]:font-semibold [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">{{ record.body }}</div>
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 md:pb-24 lg:px-8">
    <h2 class="text-xl font-semibold tracking-tight">You may also like</h2>
    <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-4">
      {% assign shown = 0 %}
      {% for product in data.products %}
        {% if product.id != record.id and shown < 4 %}
          {% assign shown = shown | plus: 1 %}
          {% assign tint = shown | modulo: 4 %}
          <li>
            <a href="/products/{{ product.id }}" class="group block">
              {% if product.image %}
                <img src="{{ product.image }}" alt="{{ product.name }}" class="aspect-3/4 w-full object-cover">
              {% else %}
                <div class="flex aspect-3/4 w-full items-center justify-center bg-linear-to-b text-base-content/40 {% if tint == 0 %}from-base-200 to-primary/20{% elsif tint == 1 %}from-base-200 to-secondary/20{% elsif tint == 2 %}from-base-200 to-accent/20{% else %}from-base-200 to-base-300{% endif %}">
                  <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                </div>
              {% endif %}
              <h3 class="mt-3 text-sm text-base-content/80 group-hover:underline group-hover:underline-offset-4">{{ product.name }}</h3>
              {% if product.price %}<p class="mt-1 tracking-wider tabular-nums">{{ product.price }}</p>{% endif %}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</article>

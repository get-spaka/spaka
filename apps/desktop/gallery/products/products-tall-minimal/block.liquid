<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-20 lg:px-8">
    <header class="mx-auto max-w-xl text-center">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">The collection</h2>
      <p class="mt-4 text-pretty text-base-content/70">A few things we make and love, each one finished by hand.</p>
    </header>
    <ul class="mt-10 grid gap-x-4 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {% for product in data.products %}
        {% assign tint = forloop.index0 | modulo: 4 %}
        <li>
          <a href="/products/{{ product.id }}" class="group block">
            {% if product.image %}
              <img src="{{ product.image }}" alt="{{ product.name }}" class="aspect-3/4 w-full object-cover transition duration-500 group-hover:opacity-90">
            {% else %}
              <div class="flex aspect-3/4 w-full items-center justify-center bg-linear-to-b text-base-content/40 {% if tint == 0 %}from-base-200 to-primary/20{% elsif tint == 1 %}from-base-200 to-secondary/20{% elsif tint == 2 %}from-base-200 to-accent/20{% else %}from-base-200 to-base-300{% endif %}">
                <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
            {% endif %}
            <h3 class="mt-3 text-sm text-base-content/80 group-hover:underline group-hover:underline-offset-4">{{ product.name }}</h3>
          </a>
          <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
            {% if product.price %}<span class="tracking-wider tabular-nums">{{ product.price }}</span>{% endif %}
            {% if product.badge %}<span class="badge badge-ghost badge-sm">{{ product.badge }}</span>{% endif %}
            {% if product.available == false %}
              <span class="text-sm text-base-content/70">Sold out</span>
            {% elsif product.order_link %}
              <a href="{{ product.order_link }}" class="link link-hover ml-auto text-sm font-medium">Order</a>
            {% else %}
              <a href="/contact" class="link link-hover ml-auto text-sm font-medium">Order by message</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

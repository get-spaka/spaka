<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-wider uppercase text-base-content/70">The shop</p>
      <h2 class="mt-2 text-3xl font-bold text-balance md:text-4xl">This season's favorite</h2>
    </div>
    <div class="mt-10 grid gap-8 lg:grid-cols-5">
      {% for product in data.products limit: 1 %}
        <article class="card overflow-hidden bg-base-100 shadow-sm lg:col-span-3">
          <a href="/products/{{ product.id }}" class="block" aria-label="{{ product.name }}">
            {% if product.image %}
              <img src="{{ product.image }}" alt="{{ product.name }}" class="aspect-4/3 w-full object-cover">
            {% else %}
              <div class="flex aspect-4/3 w-full items-center justify-center bg-linear-to-br from-primary/30 via-secondary/15 to-accent/25 text-base-content/50">
                <svg class="size-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><polyline points="3.29 7 12 12 20.71 7"/><path d="m7.5 4.27 9 5.15"/></svg>
              </div>
            {% endif %}
          </a>
          <div class="card-body gap-4 md:p-10">
            {% if product.category or product.badge or product.available == false %}
              <div class="flex flex-wrap items-center gap-2 text-sm">
                {% if product.badge %}<span class="badge badge-primary">{{ product.badge }}</span>{% endif %}
                {% if product.available == false %}<span class="badge badge-outline">Sold out</span>{% endif %}
                {% if product.category %}<span class="text-base-content/70">{{ product.category }}</span>{% endif %}
              </div>
            {% endif %}
            <h3 class="text-2xl font-bold text-balance md:text-3xl"><a href="/products/{{ product.id }}" class="link link-hover">{{ product.name }}</a></h3>
            {% if product.summary %}<p class="text-lg text-pretty text-base-content/70">{{ product.summary }}</p>{% endif %}
            <div class="mt-2 flex flex-wrap items-center gap-4">
              {% if product.price %}<span class="text-2xl font-bold tabular-nums">{{ product.price }}</span>{% endif %}
              {% if product.available == false %}
                <a href="/contact" class="btn btn-outline">Ask when it's back</a>
              {% elsif product.order_link %}
                <a href="{{ product.order_link }}" class="btn btn-primary">Order</a>
              {% else %}
                <a href="/contact" class="btn btn-primary">Order by message</a>
              {% endif %}
              <a href="/products/{{ product.id }}" class="link link-hover text-sm font-medium">More details</a>
            </div>
          </div>
        </article>
      {% endfor %}
      <div class="lg:col-span-2">
        <h3 class="text-sm font-semibold tracking-wider uppercase text-base-content/70">Also in the shop</h3>
        <ul class="mt-4 flex flex-col gap-4">
          {% for product in data.products offset: 1 limit: 4 %}
            {% assign tint = forloop.index | modulo: 3 %}
            <li>
              <a href="/products/{{ product.id }}" class="group flex items-center gap-4 rounded-box bg-base-100 p-3 shadow-sm">
                {% if product.image %}
                  <img src="{{ product.image }}" alt="{{ product.name }}" class="size-20 shrink-0 rounded-field object-cover">
                {% else %}
                  <div class="flex size-20 shrink-0 items-center justify-center rounded-field bg-linear-to-br text-base-content/50 {% if tint == 0 %}from-primary/25 to-secondary/20{% elsif tint == 1 %}from-secondary/25 to-accent/20{% else %}from-accent/25 to-primary/20{% endif %}">
                    <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><polyline points="3.29 7 12 12 20.71 7"/><path d="m7.5 4.27 9 5.15"/></svg>
                  </div>
                {% endif %}
                <div class="min-w-0 flex-1">
                  <p class="font-semibold text-balance group-hover:underline">{{ product.name }}</p>
                  {% if product.badge or product.available == false %}
                    <p class="mt-1 flex flex-wrap gap-1.5">
                      {% if product.badge %}<span class="badge badge-secondary badge-sm">{{ product.badge }}</span>{% endif %}
                      {% if product.available == false %}<span class="badge badge-outline badge-sm">Sold out</span>{% endif %}
                    </p>
                  {% endif %}
                </div>
                {% if product.price %}<span class="shrink-0 font-semibold tabular-nums">{{ product.price }}</span>{% endif %}
              </a>
            </li>
          {% endfor %}
        </ul>
        <a href="/products" class="btn btn-outline mt-6">See all products</a>
      </div>
    </div>
  </div>
</section>

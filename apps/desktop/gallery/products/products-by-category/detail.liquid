<article class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-20">
    <div class="breadcrumbs text-sm text-base-content/70">
      <ul>
        <li><a href="/products">Shop</a></li>
        {% if record.category %}<li>{{ record.category }}</li>{% endif %}
        <li>{{ record.name }}</li>
      </ul>
    </div>
    <div class="mt-6 grid gap-8 rounded-box bg-base-100 p-6 md:grid-cols-2 md:p-10 lg:gap-14">
      {% if record.image %}
        <img src="{{ record.image }}" alt="{{ record.name }}" class="aspect-square w-full rounded-field object-cover">
      {% else %}
        <div class="flex aspect-square w-full items-center justify-center rounded-field bg-linear-to-br from-primary/25 to-secondary/20 text-base-content/50">
          <svg class="size-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>
        </div>
      {% endif %}
      <div>
        <h1 class="text-3xl font-bold text-balance md:text-4xl">{{ record.name }}</h1>
        {% if record.badge or record.available == false %}
          <p class="mt-3 flex flex-wrap gap-2">
            {% if record.badge %}<span class="badge badge-accent">{{ record.badge }}</span>{% endif %}
            {% if record.available == false %}<span class="badge badge-outline">Sold out</span>{% endif %}
          </p>
        {% endif %}
        {% if record.price %}<p class="mt-4 text-2xl font-bold tabular-nums">{{ record.price }}</p>{% endif %}
        {% if record.summary %}<p class="mt-4 text-lg text-pretty text-base-content/70">{{ record.summary }}</p>{% endif %}
        <div class="mt-6">
          {% if record.available == false %}
            <a href="/contact" class="btn btn-outline">Ask when it's back</a>
          {% elsif record.order_link %}
            <a href="{{ record.order_link }}" class="btn btn-primary">Order</a>
          {% else %}
            <a href="/contact" class="btn btn-primary">Order by message</a>
          {% endif %}
        </div>
        <div class="mt-8 leading-relaxed [&_a]:link [&_a]:link-primary [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-bold [&_h2:first-child]:mt-0 [&_h3]:mt-6 [&_h3]:font-semibold [&_li]:mt-1 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mt-4 [&_p:first-child]:mt-0 [&_strong]:font-semibold [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">{{ record.body }}</div>
      </div>
    </div>
    {% assign shown = 0 %}
    {% for product in data.products %}
      {% if product.id != record.id and product.category == record.category %}{% assign shown = shown | plus: 1 %}{% endif %}
    {% endfor %}
    <div class="mt-14">
      <h2 class="text-2xl font-bold">{% if shown > 0 and record.category %}More in {{ record.category }}{% else %}More from the shop{% endif %}</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {% assign listed = 0 %}
        {% for product in data.products %}
          {% if product.id != record.id and listed < 3 %}
            {% if shown == 0 or product.category == record.category %}
              {% assign listed = listed | plus: 1 %}
              <li class="flex items-center justify-between gap-4 rounded-box bg-base-100 p-4">
                <a href="/products/{{ product.id }}" class="link link-hover font-semibold">{{ product.name }}</a>
                {% if product.price %}<span class="shrink-0 font-bold tabular-nums">{{ product.price }}</span>{% endif %}
              </li>
            {% endif %}
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</article>

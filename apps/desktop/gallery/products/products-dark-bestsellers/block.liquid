<section class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <p class="text-sm font-semibold tracking-widest uppercase">Bestsellers</p>
        <h2 class="mt-3 text-3xl font-bold text-balance md:text-5xl">The ones people come back for</h2>
      </div>
      <a href="/products" class="btn btn-primary self-start md:self-auto">Shop everything</a>
    </div>
    <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {% for product in data.products limit: 4 %}
        {% assign tint = forloop.index0 | modulo: 4 %}
        <li class="flex flex-col">
          <a href="/products/{{ product.id }}" class="block" aria-label="{{ product.name }}">
            {% if product.image %}
              <img src="{{ product.image }}" alt="{{ product.name }}" class="aspect-4/5 w-full rounded-box object-cover">
            {% else %}
              <div class="flex aspect-4/5 w-full items-center justify-center rounded-box bg-linear-to-br {% if tint == 0 %}from-primary to-secondary text-primary-content{% elsif tint == 1 %}from-secondary to-accent text-secondary-content{% elsif tint == 2 %}from-accent to-primary text-accent-content{% else %}from-primary to-accent text-primary-content{% endif %}">
                <svg class="size-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
              </div>
            {% endif %}
          </a>
          <div class="mt-4 flex items-center gap-3">
            <span class="text-sm font-bold tabular-nums">0{{ forloop.index }}</span>
            <span class="h-px flex-1 bg-neutral-content/30" aria-hidden="true"></span>
            {% if product.badge %}<span class="badge badge-secondary badge-sm">{{ product.badge }}</span>{% endif %}
            {% if product.available == false %}<span class="badge badge-outline badge-sm">Sold out</span>{% endif %}
          </div>
          <h3 class="mt-3 text-xl font-semibold text-balance"><a href="/products/{{ product.id }}" class="link link-hover">{{ product.name }}</a></h3>
          {% if product.summary %}<p class="mt-2 text-pretty">{{ product.summary }}</p>{% endif %}
          <div class="mt-auto flex items-center justify-between gap-3 pt-5">
            {% if product.price %}<span class="text-lg font-bold tabular-nums">{{ product.price }}</span>{% else %}<span></span>{% endif %}
            {% if product.available == false %}
              <a href="/contact" class="btn btn-sm">Ask when it's back</a>
            {% elsif product.order_link %}
              <a href="{{ product.order_link }}" class="btn btn-primary btn-sm">Order</a>
            {% else %}
              <a href="/contact" class="btn btn-primary btn-sm">Order by message</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

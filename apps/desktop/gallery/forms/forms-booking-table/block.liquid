<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-5xl px-4 py-16 md:py-24">
    <div class="grid overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm md:grid-cols-5">
      <div class="bg-neutral p-8 text-neutral-content md:col-span-2 md:p-10">
        <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
        <h2 class="mt-4 text-3xl font-bold text-balance">Book a table</h2>
        <p class="mt-3 text-pretty">Choose a day and a time and we will keep a table for you. We confirm every booking by email.</p>
        <dl class="mt-8 space-y-4">
          <div>
            <dt class="font-semibold">Lunch</dt>
            <dd>Tuesday to Sunday, 12 pm to 2:30 pm</dd>
          </div>
          <div>
            <dt class="font-semibold">Dinner</dt>
            <dd>Tuesday to Saturday, 7 pm to 10 pm</dd>
          </div>
          <div>
            <dt class="font-semibold">Groups of more than 12</dt>
            <dd>Call us on <a href="tel:+15550142290" class="link">+1 (555) 014-2290</a></dd>
          </div>
        </dl>
      </div>
      <form hx-post="/_data/bookings" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#forms-booking-table-problems swap:innerHTML" class="grid grid-cols-1 gap-x-4 gap-y-1 p-6 sm:grid-cols-2 md:col-span-3 md:p-10">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Date</legend>
          <input name="date" type="date" class="input input-bordered w-full" required>
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Time</legend>
          <select name="time" class="select select-bordered w-full">
            <option value="12:00">12:00 pm</option>
            <option value="12:30">12:30 pm</option>
            <option value="13:00">1:00 pm</option>
            <option value="13:30">1:30 pm</option>
            <option value="19:00" selected>7:00 pm</option>
            <option value="19:30">7:30 pm</option>
            <option value="20:00">8:00 pm</option>
            <option value="20:30">8:30 pm</option>
            <option value="21:00">9:00 pm</option>
          </select>
        </fieldset>
        <fieldset class="fieldset sm:col-span-2">
          <legend class="fieldset-legend">Number of guests</legend>
          <input name="guests" type="number" class="input input-bordered w-full" min="1" max="12" value="2">
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Your name</legend>
          <input name="name" type="text" class="input input-bordered w-full" required maxlength="200" autocomplete="name">
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Your phone <span class="font-normal text-base-content/70">(optional)</span></legend>
          <input name="phone" type="tel" class="input input-bordered w-full" maxlength="30" autocomplete="tel">
        </fieldset>
        <fieldset class="fieldset sm:col-span-2">
          <legend class="fieldset-legend">Your email</legend>
          <input name="email" type="email" class="input input-bordered w-full" required maxlength="200" autocomplete="email">
        </fieldset>
        <fieldset class="fieldset sm:col-span-2">
          <legend class="fieldset-legend">Allergies or a special occasion? <span class="font-normal text-base-content/70">(optional)</span></legend>
          <textarea name="message" class="textarea textarea-bordered w-full" rows="3" maxlength="2000"></textarea>
        </fieldset>
        <div id="forms-booking-table-problems" class="sm:col-span-2"></div>
        <div class="mt-3 sm:col-span-2">
          <button type="submit" class="btn btn-primary w-full">Request my table</button>
        </div>
      </form>
    </div>
  </div>
</section>

<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 md:grid-cols-2 md:py-24 lg:gap-20">
    <div>
      <p class="text-sm font-semibold tracking-wider uppercase text-base-content/70">Contact</p>
      <h2 class="mt-3 text-3xl font-bold text-balance md:text-4xl">Come and see us, or drop us a line</h2>
      <p class="mt-4 text-pretty text-base-content/70">We are a small team and we read every message ourselves. Call during opening hours, or write to us and we will get back to you the same day.</p>
      <dl class="mt-8 space-y-6">
        <div class="flex gap-4">
          <dt class="flex size-11 shrink-0 items-center justify-center rounded-field bg-base-200">
            <span class="sr-only">Address</span>
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          </dt>
          <dd>
            <p class="font-semibold">Your business</p>
            <p class="text-base-content/70">12 Market Street<br>Springfield, IL 62701</p>
          </dd>
        </div>
        <div class="flex gap-4">
          <dt class="flex size-11 shrink-0 items-center justify-center rounded-field bg-base-200">
            <span class="sr-only">Phone</span>
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
          </dt>
          <dd>
            <a href="tel:+15550142290" class="link link-hover font-semibold">+1 (555) 014-2290</a>
            <p class="text-base-content/70">Monday to Friday, 9 am to 6 pm</p>
          </dd>
        </div>
        <div class="flex gap-4">
          <dt class="flex size-11 shrink-0 items-center justify-center rounded-field bg-base-200">
            <span class="sr-only">Email</span>
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </dt>
          <dd>
            <a href="mailto:hello@yourbusiness.com" class="link link-hover font-semibold">hello@yourbusiness.com</a>
            <p class="text-base-content/70">We reply within one working day</p>
          </dd>
        </div>
      </dl>
    </div>
    <form hx-post="/_data/contact" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#forms-contact-beside-address-problems swap:innerHTML" class="flex flex-col gap-2 rounded-box bg-base-200 p-6 md:p-8">
      <h3 class="text-xl font-semibold">Send us a message</h3>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Your name</legend>
        <input name="name" type="text" class="input input-bordered w-full" required maxlength="200" autocomplete="name">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Your email</legend>
        <input name="email" type="email" class="input input-bordered w-full" required maxlength="200" autocomplete="email">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Your phone <span class="font-normal text-base-content/70">(optional)</span></legend>
        <input name="phone" type="tel" class="input input-bordered w-full" maxlength="30" autocomplete="tel">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Your message</legend>
        <textarea name="message" class="textarea textarea-bordered w-full" rows="5" required maxlength="5000"></textarea>
      </fieldset>
      <div id="forms-contact-beside-address-problems"></div>
      <button type="submit" class="btn btn-primary mt-2 self-start">Send message</button>
    </form>
  </div>
</section>

<section class="bg-primary text-primary-content">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 md:grid-cols-5 md:py-20">
    <div class="md:col-span-2">
      <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
      <h2 class="mt-4 text-3xl font-bold text-balance md:text-4xl">Ask us anything</h2>
      <p class="mt-4 text-lg text-pretty">No question is too small. Tell us what you need and a real person will answer, usually within a few hours.</p>
    </div>
    <form hx-post="/_data/contact" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#forms-contact-ask-band-problems swap:innerHTML" class="grid grid-cols-1 gap-x-4 gap-y-1 sm:grid-cols-2 md:col-span-3">
      <fieldset class="fieldset">
        <legend class="fieldset-legend text-primary-content">Your name</legend>
        <input name="name" type="text" class="input input-bordered w-full" required maxlength="200" autocomplete="name">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend text-primary-content">Your email</legend>
        <input name="email" type="email" class="input input-bordered w-full" required maxlength="200" autocomplete="email">
      </fieldset>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend text-primary-content">Your question</legend>
        <textarea name="message" class="textarea textarea-bordered w-full" rows="3" required maxlength="2000"></textarea>
      </fieldset>
      <div id="forms-contact-ask-band-problems" class="sm:col-span-2"></div>
      <div class="mt-3 sm:col-span-2">
        <button type="submit" class="btn btn-neutral w-full sm:w-auto">Ask your question</button>
      </div>
    </form>
  </div>
</section>

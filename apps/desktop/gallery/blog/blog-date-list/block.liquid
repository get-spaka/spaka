<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-5xl gap-8 px-4 py-16 md:grid-cols-3 md:gap-12 md:py-24">
    <div>
      <h2 class="text-3xl font-bold text-balance">News</h2>
      <p class="mt-3 text-base-content/70">What is new with us, in a few lines.</p>
    </div>
    <ul class="divide-y divide-base-300 border-y border-base-300 md:col-span-2">
      {% for post in data.blog limit: 6 %}
        <li>
          <a href="/blog/{{ post.id }}" class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6">
            {% if post.date %}<time datetime="{{ post.date }}" class="shrink-0 text-sm text-base-content/70 tabular-nums sm:w-36">{{ post.date | date: "%-d %B %Y" }}</time>{% endif %}
            <span class="flex-1 font-medium group-hover:underline">{{ post.title }}</span>
            <svg class="hidden size-4 shrink-0 self-center text-base-content/70 transition-transform group-hover:translate-x-1 sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

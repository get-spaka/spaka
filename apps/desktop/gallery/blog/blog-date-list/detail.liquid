<article class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-2xl px-4 py-16 md:py-24">
    <p class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-base-content/70">
      {% if record.date %}<time datetime="{{ record.date }}">{{ record.date | date: "%-d %B %Y" }}</time>{% endif %}
      {% if record.category %}<span>{{ record.category }}</span>{% endif %}
      {% if record.author %}<span>{{ record.author }}</span>{% endif %}
    </p>
    <h1 class="mt-3 text-3xl font-bold text-balance md:text-4xl">{{ record.title }}</h1>
    {% if record.summary %}<p class="mt-4 text-lg text-base-content/70">{{ record.summary }}</p>{% endif %}
    {% if record.cover %}<img src="{{ record.cover }}" alt="{{ record.title }}" class="mt-8 aspect-video w-full rounded-box object-cover">{% endif %}
    <div class="mt-8 border-t border-base-300 pt-8 leading-relaxed [&_a]:link [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-semibold [&_h3]:mt-6 [&_h3]:font-semibold [&_li]:mt-1 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mt-4 [&_p:first-child]:mt-0 [&_strong]:font-semibold [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">{{ record.body }}</div>
    <div class="mt-16">
      <h2 class="text-sm font-semibold tracking-wider uppercase text-base-content/70">More news</h2>
      <ul class="mt-4 divide-y divide-base-300 border-y border-base-300">
        {% assign shown = 0 %}
        {% for post in data.blog %}
          {% if post.id != record.id and shown < 4 %}
            {% assign shown = shown | plus: 1 %}
            <li>
              <a href="/blog/{{ post.id }}" class="group flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:gap-6">
                {% if post.date %}<time datetime="{{ post.date }}" class="shrink-0 text-sm text-base-content/70 tabular-nums sm:w-36">{{ post.date | date: "%-d %B %Y" }}</time>{% endif %}
                <span class="flex-1 font-medium group-hover:underline">{{ post.title }}</span>
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
      <a href="/blog" class="link link-hover mt-6 inline-flex items-center gap-2 text-sm">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        All news
      </a>
    </div>
  </div>
</article>

<article class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-4xl px-4 py-16 md:py-24">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-center">
      <div class="shrink-0 sm:w-56">
        {% if record.cover %}
          <img src="{{ record.cover }}" alt="{{ record.title }}" class="aspect-[4/3] w-full rounded-box object-cover sm:aspect-square">
        {% else %}
          <div class="flex aspect-[4/3] w-full items-center justify-center rounded-box bg-linear-to-br from-primary/25 to-primary/5 text-base-content/50 sm:aspect-square">
            <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          </div>
        {% endif %}
      </div>
      <div>
        <p class="flex flex-wrap gap-x-3 text-sm text-base-content/70">
          {% if record.date %}<time datetime="{{ record.date }}">{{ record.date | date: "%-d %B %Y" }}</time>{% endif %}
          {% if record.category %}<span class="font-medium">{{ record.category }}</span>{% endif %}
        </p>
        <h1 class="mt-2 text-3xl font-bold text-balance md:text-4xl">{{ record.title }}</h1>
        {% if record.summary %}<p class="mt-3 text-lg text-base-content/70">{{ record.summary }}</p>{% endif %}
        {% if record.author %}<p class="mt-4 text-sm">{{ record.author }}</p>{% endif %}
      </div>
    </div>
    <div class="mt-12 border-t border-base-300 pt-10 text-lg leading-relaxed [&_a]:link [&_a]:link-primary [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_li]:mt-1 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mt-4 [&_p:first-child]:mt-0 [&_strong]:font-semibold [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">{{ record.body }}</div>
    <div class="mt-16 rounded-box bg-base-200 p-6 md:p-8">
      <h2 class="text-xl font-bold">Keep reading</h2>
      <div class="mt-6 divide-y divide-base-300">
        {% assign shown = 0 %}
        {% for post in data.blog %}
          {% if post.id != record.id and shown < 3 %}
            {% assign shown = shown | plus: 1 %}
            <a href="/blog/{{ post.id }}" class="group flex items-center gap-4 py-4 first:pt-0 last:pb-0">
              {% if post.cover %}
                <img src="{{ post.cover }}" alt="{{ post.title }}" class="size-16 shrink-0 rounded-box object-cover">
              {% else %}
                <div class="flex size-16 shrink-0 items-center justify-center rounded-box bg-linear-to-br text-base-content/50 {% if shown == 1 %}from-secondary/25 to-secondary/5{% elsif shown == 2 %}from-accent/25 to-accent/5{% else %}from-primary/25 to-primary/5{% endif %}">
                  <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                </div>
              {% endif %}
              <div>
                {% if post.date %}<p class="text-sm text-base-content/70"><time datetime="{{ post.date }}">{{ post.date | date: "%-d %B %Y" }}</time></p>{% endif %}
                <h3 class="font-semibold group-hover:underline">{{ post.title }}</h3>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</article>

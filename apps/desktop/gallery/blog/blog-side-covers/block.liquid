<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-4xl px-4 py-16 md:py-24">
    <h2 class="text-3xl font-bold text-balance md:text-4xl">Recent posts</h2>
    <p class="mt-3 text-lg text-base-content/70">A little news from us every few weeks.</p>
    <div class="mt-10 divide-y divide-base-300">
      {% for post in data.blog limit: 5 %}
        {% assign tone = forloop.index | modulo: 4 %}
        <article class="flex flex-col gap-5 py-6 first:pt-0 sm:flex-row sm:items-center sm:gap-8">
          <a href="/blog/{{ post.id }}" class="block shrink-0 sm:w-44">
            {% if post.cover %}
              <img src="{{ post.cover }}" alt="{{ post.title }}" class="aspect-[4/3] w-full rounded-box object-cover sm:aspect-square">
            {% else %}
              <div class="flex aspect-[4/3] w-full items-center justify-center rounded-box bg-linear-to-br text-base-content/50 sm:aspect-square {% if tone == 1 %}from-primary/25 to-primary/5{% elsif tone == 2 %}from-secondary/25 to-secondary/5{% elsif tone == 3 %}from-accent/25 to-accent/5{% else %}from-base-content/15 to-base-content/5{% endif %}">
                <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
            {% endif %}
          </a>
          <div class="flex-1">
            <p class="flex flex-wrap gap-x-3 text-sm text-base-content/70">
              {% if post.date %}<time datetime="{{ post.date }}">{{ post.date | date: "%-d %B %Y" }}</time>{% endif %}
              {% if post.category %}<span class="font-medium">{{ post.category }}</span>{% endif %}
            </p>
            <h3 class="mt-1 text-xl font-semibold text-balance md:text-2xl"><a href="/blog/{{ post.id }}" class="link link-hover">{{ post.title }}</a></h3>
            {% if post.summary %}<p class="mt-2 text-base-content/70">{{ post.summary }}</p>{% endif %}
            {% if post.author %}<p class="mt-3 text-sm">{{ post.author }}</p>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

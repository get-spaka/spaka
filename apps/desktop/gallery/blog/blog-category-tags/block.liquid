<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-5xl px-4 py-16 md:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">On the blog</h2>
      <p class="mt-3 text-lg text-base-content/70">News, tips and behind-the-scenes stories, sorted by topic.</p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {% for post in data.blog limit: 6 %}
        {% assign tone = forloop.index | modulo: 3 %}
        <article class="flex flex-col rounded-box border border-base-300 bg-base-100 p-6 transition-colors hover:border-base-content/40">
          <div class="flex flex-wrap items-center justify-between gap-3">
            {% if post.category %}<span class="badge {% if tone == 1 %}badge-primary{% elsif tone == 2 %}badge-secondary{% else %}badge-accent{% endif %}">{{ post.category }}</span>{% endif %}
            {% if post.date %}<time datetime="{{ post.date }}" class="text-sm text-base-content/70">{{ post.date | date: "%-d %B %Y" }}</time>{% endif %}
          </div>
          <h3 class="mt-4 text-xl font-semibold text-balance"><a href="/blog/{{ post.id }}" class="link link-hover">{{ post.title }}</a></h3>
          {% if post.summary %}<p class="mt-2 text-base-content/70">{{ post.summary }}</p>{% endif %}
          <div class="mt-auto flex items-center justify-between gap-4 pt-6">
            {% if post.author %}
              <div class="flex items-center gap-3">
                <div class="avatar avatar-placeholder">
                  <div class="w-8 rounded-full bg-base-200 text-base-content">
                    <span class="text-xs font-semibold" aria-hidden="true">{{ post.author | slice: 0 }}</span>
                  </div>
                </div>
                <span class="text-sm font-medium">{{ post.author }}</span>
              </div>
            {% endif %}
            <a href="/blog/{{ post.id }}" class="link link-primary text-sm font-medium">Read</a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<article class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <div class="flex flex-wrap items-center gap-3 text-sm">
          {% if record.category %}<span class="badge badge-primary">{{ record.category }}</span>{% endif %}
          {% if record.date %}<time datetime="{{ record.date }}" class="text-base-content/70">{{ record.date | date: "%-d %B %Y" }}</time>{% endif %}
        </div>
        <h1 class="mt-4 text-4xl font-bold text-balance md:text-5xl">{{ record.title }}</h1>
        {% if record.summary %}<p class="mt-4 text-xl text-pretty text-base-content/70">{{ record.summary }}</p>{% endif %}
        {% if record.author %}<p class="mt-6 text-sm">By <span class="font-medium">{{ record.author }}</span></p>{% endif %}
      </div>
      {% if record.cover %}
        <img src="{{ record.cover }}" alt="{{ record.title }}" class="aspect-video w-full rounded-box object-cover">
      {% else %}
        <div class="flex aspect-video w-full items-center justify-center rounded-box bg-linear-to-br from-primary/30 to-accent/25 text-base-content/50">
          <svg class="size-14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18h-5"/><path d="M18 14h-8"/><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9a2 2 0 0 1 2-2h2"/><rect width="8" height="4" x="10" y="6" rx="1"/></svg>
        </div>
      {% endif %}
    </div>
    <div class="mt-12 grid gap-10 lg:grid-cols-3">
      <div class="rounded-box bg-base-100 p-6 text-lg leading-relaxed md:p-10 lg:col-span-2 [&_a]:link [&_a]:link-primary [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h2:first-child]:mt-0 [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_li]:mt-1 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mt-4 [&_p:first-child]:mt-0 [&_strong]:font-semibold [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">{{ record.body }}</div>
      <div>
        <h2 class="text-sm font-semibold tracking-wider uppercase text-base-content/70">Also on the blog</h2>
        <ul class="mt-4 divide-y divide-base-300">
          {% assign shown = 0 %}
          {% for post in data.blog %}
            {% if post.id != record.id and shown < 4 %}
              {% assign shown = shown | plus: 1 %}
              <li class="py-5 first:pt-0">
                {% if post.date %}<p class="text-sm text-base-content/70"><time datetime="{{ post.date }}">{{ post.date | date: "%-d %B %Y" }}</time></p>{% endif %}
                <h3 class="mt-1 text-lg font-semibold text-balance"><a href="/blog/{{ post.id }}" class="link link-hover">{{ post.title }}</a></h3>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
        <a href="/blog" class="btn btn-outline mt-6">All posts</a>
      </div>
    </div>
  </div>
</article>

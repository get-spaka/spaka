<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl font-bold text-balance md:text-4xl">From the blog</h2>
        <p class="mt-3 text-lg text-base-content/70">News, tips and stories from the team.</p>
      </div>
      <a href="/blog" class="btn btn-ghost">All posts</a>
    </div>
    <hr class="my-8 border-base-300">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
      {% for post in data.blog limit: 3 %}
        {% assign tone = forloop.index | modulo: 3 %}
        <article class="flex flex-col">
          <a href="/blog/{{ post.id }}" class="block">
            {% if post.cover %}
              <img src="{{ post.cover }}" alt="{{ post.title }}" class="aspect-[4/3] w-full rounded-box object-cover">
            {% else %}
              <div class="flex aspect-[4/3] w-full items-center justify-center rounded-box bg-linear-to-br text-base-content/50 {% if tone == 1 %}from-primary/25 to-secondary/25{% elsif tone == 2 %}from-secondary/25 to-accent/25{% else %}from-accent/25 to-primary/25{% endif %}">
                <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18h-5"/><path d="M18 14h-8"/><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9a2 2 0 0 1 2-2h2"/><rect width="8" height="4" x="10" y="6" rx="1"/></svg>
              </div>
            {% endif %}
          </a>
          <div class="mt-6 flex flex-1 flex-col">
            {% if post.category %}<p class="text-sm font-semibold tracking-wider uppercase text-base-content/70">{{ post.category }}</p>{% endif %}
            <h3 class="mt-2 text-xl font-semibold text-balance"><a href="/blog/{{ post.id }}" class="link link-hover">{{ post.title }}</a></h3>
            {% if post.summary %}<p class="mt-3 text-base-content/70">{{ post.summary }}</p>{% endif %}
            <div class="mt-auto flex items-end justify-between gap-4 pt-6">
              <div class="text-sm">
                {% if post.author %}<p class="font-medium">{{ post.author }}</p>{% endif %}
                {% if post.date %}<p class="text-base-content/70"><time datetime="{{ post.date }}">{{ post.date | date: "%-d %B %Y" }}</time></p>{% endif %}
              </div>
              <a href="/blog/{{ post.id }}" class="link link-primary text-sm font-medium">Read more</a>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

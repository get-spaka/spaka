<article class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-3xl px-4 py-16 md:py-24">
    <a href="/blog" class="link link-hover text-sm text-base-content/70">Back to the blog</a>
    {% if record.category %}<p class="mt-8 text-sm font-semibold tracking-wider uppercase text-base-content/70">{{ record.category }}</p>{% endif %}
    <h1 class="mt-2 text-4xl font-bold text-balance md:text-5xl">{{ record.title }}</h1>
    {% if record.summary %}<p class="mt-4 text-xl text-pretty text-base-content/70">{{ record.summary }}</p>{% endif %}
    <div class="mt-6 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {% if record.author %}<span class="font-medium">{{ record.author }}</span>{% endif %}
      {% if record.date %}<time datetime="{{ record.date }}" class="text-base-content/70">{{ record.date | date: "%-d %B %Y" }}</time>{% endif %}
    </div>
    {% if record.cover %}
      <img src="{{ record.cover }}" alt="{{ record.title }}" class="mt-10 aspect-video w-full rounded-box object-cover">
    {% else %}
      <div class="mt-10 flex aspect-video w-full items-center justify-center rounded-box bg-linear-to-br from-primary/25 to-secondary/25 text-base-content/50">
        <svg class="size-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18h-5"/><path d="M18 14h-8"/><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9a2 2 0 0 1 2-2h2"/><rect width="8" height="4" x="10" y="6" rx="1"/></svg>
      </div>
    {% endif %}
    <div class="mt-10 text-lg leading-relaxed [&_a]:link [&_a]:link-primary [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_li]:mt-1 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mt-4 [&_strong]:font-semibold [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">{{ record.body }}</div>
  </div>
  <div class="border-t border-base-300 bg-base-200">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-2xl font-bold">More from the blog</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {% assign shown = 0 %}
        {% for post in data.blog %}
          {% if post.id != record.id and shown < 3 %}
            {% assign shown = shown | plus: 1 %}
            <article>
              <a href="/blog/{{ post.id }}" class="block">
                {% if post.cover %}
                  <img src="{{ post.cover }}" alt="{{ post.title }}" class="aspect-[4/3] w-full rounded-box object-cover">
                {% else %}
                  <div class="flex aspect-[4/3] w-full items-center justify-center rounded-box bg-linear-to-br text-base-content/50 {% if shown == 1 %}from-secondary/25 to-accent/25{% elsif shown == 2 %}from-accent/25 to-primary/25{% else %}from-primary/25 to-secondary/25{% endif %}">
                    <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18h-5"/><path d="M18 14h-8"/><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9a2 2 0 0 1 2-2h2"/><rect width="8" height="4" x="10" y="6" rx="1"/></svg>
                  </div>
                {% endif %}
              </a>
              {% if post.date %}<p class="mt-4 text-sm text-base-content/70"><time datetime="{{ post.date }}">{{ post.date | date: "%-d %B %Y" }}</time></p>{% endif %}
              <h3 class="mt-1 text-lg font-semibold text-balance"><a href="/blog/{{ post.id }}" class="link link-hover">{{ post.title }}</a></h3>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</article>

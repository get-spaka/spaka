<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="border-b-2 border-base-content pb-6">
      <p class="text-sm font-semibold tracking-widest uppercase text-base-content/70">The journal</p>
      <h2 class="mt-2 font-serif text-5xl leading-none font-bold tracking-tight text-balance md:text-7xl">Notes from the shop</h2>
    </div>
    <div class="grid gap-12 pt-10 md:grid-cols-2 md:gap-0 md:divide-x md:divide-base-300">
      {% for post in data.blog limit: 1 %}
        <article class="md:pr-12">
          <a href="/blog/{{ post.id }}" class="block">
            {% if post.cover %}
              <img src="{{ post.cover }}" alt="{{ post.title }}" class="aspect-[4/3] w-full object-cover">
            {% else %}
              <div class="flex aspect-[4/3] w-full items-center justify-center bg-linear-to-br from-secondary/25 to-primary/20 text-base-content/50">
                <svg class="size-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/></svg>
              </div>
            {% endif %}
          </a>
          {% if post.category %}<p class="mt-6 text-sm font-semibold tracking-widest uppercase text-base-content/70">{{ post.category }}</p>{% endif %}
          <h3 class="mt-2 font-serif text-4xl leading-tight font-bold text-balance md:text-5xl"><a href="/blog/{{ post.id }}" class="link link-hover">{{ post.title }}</a></h3>
          {% if post.summary %}<p class="mt-4 font-serif text-xl leading-relaxed text-pretty text-base-content/70">{{ post.summary }}</p>{% endif %}
          <p class="mt-6 text-sm">
            {% if post.author %}By <span class="font-semibold">{{ post.author }}</span>{% endif %}
            {% if post.date %}<time datetime="{{ post.date }}" class="ml-2 text-base-content/70">{{ post.date | date: "%-d %B %Y" }}</time>{% endif %}
          </p>
        </article>
      {% endfor %}
      <div class="flex flex-col divide-y divide-base-300 md:pl-12">
        {% for post in data.blog offset: 1 limit: 3 %}
          <article class="py-8 first:pt-0 last:pb-0">
            <p class="text-sm text-base-content/70">
              {% if post.category %}<span class="font-semibold tracking-widest uppercase">{{ post.category }}</span>{% endif %}
              {% if post.date %}<time datetime="{{ post.date }}" class="ml-2">{{ post.date | date: "%-d %B %Y" }}</time>{% endif %}
            </p>
            <h3 class="mt-2 font-serif text-2xl leading-snug font-bold text-balance md:text-3xl"><a href="/blog/{{ post.id }}" class="link link-hover">{{ post.title }}</a></h3>
            {% if post.summary %}<p class="mt-3 font-serif text-lg text-pretty text-base-content/70">{{ post.summary }}</p>{% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

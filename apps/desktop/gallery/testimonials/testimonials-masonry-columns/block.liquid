<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Kind words from our customers</h2>
      <p class="mt-4 text-lg text-base-content/70">Short notes from the people we work with every week.</p>
    </div>
    <div class="mt-12 columns-1 gap-6 sm:columns-2 lg:columns-3">
      {% for item in data.testimonials %}
        <figure class="mb-6 break-inside-avoid rounded-box border border-base-300 bg-base-100 p-6">
          {% if item.rating != blank %}
            <div class="flex items-center gap-0.5 text-accent">
              <span class="sr-only">Rated {{ item.rating }} out of 5</span>
              {% for i in (1..5) %}
                <svg class="size-4" viewBox="0 0 24 24" fill="{% if i <= item.rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
              {% endfor %}
            </div>
          {% endif %}
          <blockquote class="mt-4">
            <p class="text-base-content/80">“{{ item.quote }}”</p>
          </blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            {% if item.photo != blank %}
              <div class="avatar">
                <div class="w-9 rounded-full">
                  <img src="{{ item.photo }}" alt="{{ item.name }}" class="object-cover">
                </div>
              </div>
            {% else %}
              {% assign words = item.name | split: " " %}
              <div class="avatar avatar-placeholder">
                <div class="w-9 rounded-full bg-secondary text-secondary-content">
                  <span class="text-xs font-semibold">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span>
                </div>
              </div>
            {% endif %}
            <div class="text-sm">
              <p class="font-semibold">{{ item.name }}</p>
              {% if item.role != blank %}<p class="text-base-content/70">{{ item.role }}</p>{% endif %}
            </div>
          </figcaption>
        </figure>
      {% endfor %}
    </div>
  </div>
</section>

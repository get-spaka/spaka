<section class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <p class="text-sm font-semibold tracking-widest uppercase">Testimonials</p>
        <h2 class="mt-2 text-3xl font-bold text-balance md:text-4xl">Our customers say it best</h2>
      </div>
      <a href="/contact" class="btn btn-primary self-start md:self-auto">Work with us</a>
    </div>
    <div class="mt-12 grid divide-y divide-neutral-content/20 border-y border-neutral-content/20 md:grid-cols-3 md:divide-x md:divide-y-0">
      {% for item in data.testimonials limit: 3 %}
        <figure class="flex flex-col gap-4 py-8 md:px-8 md:first:pl-0 md:last:pr-0">
          <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/></svg>
          {% if item.headline != blank %}<h3 class="text-lg font-bold">{{ item.headline }}</h3>{% endif %}
          <blockquote>
            <p class="text-pretty">{{ item.quote }}</p>
          </blockquote>
          <figcaption class="mt-auto pt-4">
            <p class="font-semibold">{{ item.name }}</p>
            {% if item.role != blank %}<p class="text-sm">{{ item.role }}</p>{% endif %}
          </figcaption>
        </figure>
      {% endfor %}
    </div>
  </div>
</section>

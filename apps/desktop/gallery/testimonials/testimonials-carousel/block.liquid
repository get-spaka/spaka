<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-4xl px-4 py-16 md:py-24">
    <h2 class="text-center text-3xl font-bold text-balance md:text-4xl">What people tell us</h2>
    {% assign items = data.testimonials %}
    {% assign last = items.size | minus: 1 %}
    <div class="carousel mt-10 w-full rounded-box bg-base-100">
      {% for item in items %}
        {% if forloop.first %}{% assign previous = items[last] %}{% else %}{% assign p = forloop.index0 | minus: 1 %}{% assign previous = items[p] %}{% endif %}
        {% if forloop.last %}{% assign following = items.first %}{% else %}{% assign following = items[forloop.index] %}{% endif %}
        <figure id="testimonial-{{ item.id }}" class="carousel-item w-full flex-col items-center px-6 py-10 text-center md:px-16 md:py-14">
          {% if item.rating != blank %}
            <div class="flex items-center gap-1 text-accent">
              <span class="sr-only">Rated {{ item.rating }} out of 5</span>
              {% for i in (1..5) %}
                <svg class="size-5" viewBox="0 0 24 24" fill="{% if i <= item.rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
              {% endfor %}
            </div>
          {% endif %}
          <blockquote class="mt-6">
            <p class="text-xl font-medium text-balance md:text-2xl">“{{ item.quote }}”</p>
          </blockquote>
          <figcaption class="mt-6">
            <p class="font-semibold">{{ item.name }}</p>
            {% if item.role != blank %}<p class="text-sm text-base-content/70">{{ item.role }}</p>{% endif %}
          </figcaption>
          {% if items.size > 1 %}
            <div class="mt-8 flex items-center gap-4">
              <a href="#testimonial-{{ previous.id }}" class="btn btn-circle btn-outline btn-sm" aria-label="Previous testimonial">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
              </a>
              <span class="text-sm text-base-content/70">{{ forloop.index }} / {{ forloop.length }}</span>
              <a href="#testimonial-{{ following.id }}" class="btn btn-circle btn-outline btn-sm" aria-label="Next testimonial">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            </div>
          {% endif %}
        </figure>
      {% endfor %}
    </div>
  </div>
</section>

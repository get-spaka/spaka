<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 md:grid-cols-3 md:py-24">
    <div>
      <h2 class="text-3xl font-bold text-balance">What our customers say</h2>
      {% assign total = 0 %}
      {% assign count = 0 %}
      {% for item in data.testimonials %}
        {% if item.rating != blank %}
          {% assign total = total | plus: item.rating %}
          {% assign count = count | plus: 1 %}
        {% endif %}
      {% endfor %}
      {% if count > 0 %}
        {% assign average = total | times: 1.0 | divided_by: count | round: 1 %}
        {% assign stars = average | round %}
        <div class="mt-6 flex items-center gap-1 text-accent">
          {% for i in (1..5) %}
            <svg class="size-6" viewBox="0 0 24 24" fill="{% if i <= stars %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
          {% endfor %}
        </div>
        <p class="mt-3 text-lg"><strong>{{ average }} out of 5</strong></p>
        <p class="text-base-content/70">Based on {{ count }} {% if count == 1 %}review{% else %}reviews{% endif %}</p>
      {% endif %}
      <a href="#" class="btn btn-outline btn-sm mt-6">Write a review</a>
    </div>
    <ul class="space-y-4 md:col-span-2">
      {% for item in data.testimonials %}
        <li class="rounded-box border border-base-300 p-6">
          {% if item.rating != blank %}
            <div class="flex items-center gap-1 text-accent">
              <span class="sr-only">Rated {{ item.rating }} out of 5</span>
              {% for i in (1..5) %}
                <svg class="size-4" viewBox="0 0 24 24" fill="{% if i <= item.rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
              {% endfor %}
            </div>
          {% endif %}
          {% if item.headline != blank %}<h3 class="mt-3 font-semibold">{{ item.headline }}</h3>{% endif %}
          <p class="mt-1 text-base-content/70">{{ item.quote }}</p>
          <p class="mt-3 text-sm text-base-content/70">{{ item.name }}{% if item.date != blank %} · {{ item.date | date: "%B %Y" }}{% endif %}</p>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="bg-base-100 text-base-content">
  {% for item in data.testimonials limit: 1 %}
    <figure class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 md:grid-cols-5 md:gap-16 md:py-24">
      <div class="md:col-span-2">
        {% if item.photo != blank %}
          <img src="{{ item.photo }}" alt="{{ item.name }}" class="aspect-4/5 w-full rounded-box object-cover">
        {% else %}
          <div class="flex aspect-4/5 w-full items-center justify-center rounded-box bg-linear-to-br from-primary/20 to-accent/20 text-primary">
            <svg class="size-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
          </div>
        {% endif %}
      </div>
      <div class="md:col-span-3">
        <p class="text-sm font-semibold tracking-wider uppercase text-base-content/70">A customer’s story</p>
        {% if item.headline != blank %}<h2 class="mt-3 text-3xl font-bold text-balance md:text-4xl">{{ item.headline }}</h2>{% endif %}
        <blockquote class="mt-6 border-l-4 border-primary pl-6">
          <p class="text-xl text-pretty text-base-content/80 md:text-2xl">“{{ item.quote }}”</p>
        </blockquote>
        <figcaption class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <div>
            <p class="text-lg font-semibold">{{ item.name }}</p>
            {% if item.role != blank %}<p class="text-base-content/70">{{ item.role }}</p>{% endif %}
          </div>
          {% if item.rating != blank %}
            <div class="flex items-center gap-1 text-accent">
              <span class="sr-only">Rated {{ item.rating }} out of 5</span>
              {% for i in (1..5) %}
                <svg class="size-5" viewBox="0 0 24 24" fill="{% if i <= item.rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
              {% endfor %}
            </div>
          {% endif %}
        </figcaption>
        <a href="/contact" class="btn btn-primary mt-10">Start your project</a>
      </div>
    </figure>
  {% endfor %}
</section>

<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Loved by small businesses</h2>
      <p class="mt-4 text-lg text-base-content/70">Here is what a few of our customers have to say.</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {% for item in data.testimonials %}
        <figure class="card bg-base-200">
          <div class="card-body justify-between gap-6">
            <blockquote>
              <p class="text-base-content/80">“{{ item.quote }}”</p>
            </blockquote>
            <figcaption class="flex items-center gap-3">
              {% if item.photo != blank %}
                <div class="avatar">
                  <div class="w-10 rounded-full">
                    <img src="{{ item.photo }}" alt="{{ item.name }}" class="object-cover">
                  </div>
                </div>
              {% else %}
                {% assign words = item.name | split: " " %}
                <div class="avatar avatar-placeholder">
                  <div class="w-10 rounded-full bg-primary text-primary-content">
                    <span class="text-sm font-semibold">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span>
                  </div>
                </div>
              {% endif %}
              <div>
                <p class="font-semibold">{{ item.name }}</p>
                {% if item.role != blank %}<p class="text-sm text-base-content/70">{{ item.role }}</p>{% endif %}
              </div>
            </figcaption>
          </div>
        </figure>
      {% endfor %}
    </div>
  </div>
</section>

<section class="bg-primary text-primary-content">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 md:grid-cols-2 md:py-24">
    <div>
      <h2 class="text-sm font-semibold tracking-wider uppercase opacity-90">Trusted by teams like yours</h2>
      {% for item in data.testimonials limit: 1 %}
        <figure class="mt-6">
          <blockquote>
            <p class="text-2xl font-semibold text-balance md:text-3xl">“{{ item.quote }}”</p>
          </blockquote>
          <figcaption class="mt-8 flex items-center gap-3">
            {% if item.photo != blank %}
              <div class="avatar">
                <div class="w-12 rounded-full">
                  <img src="{{ item.photo }}" alt="{{ item.name }}" class="object-cover">
                </div>
              </div>
            {% else %}
              {% assign words = item.name | split: " " %}
              <div class="avatar avatar-placeholder">
                <div class="w-12 rounded-full bg-primary-content text-primary">
                  <span class="font-semibold">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span>
                </div>
              </div>
            {% endif %}
            <div>
              <p class="font-semibold">{{ item.name }}</p>
              {% if item.role != blank %}<p class="text-sm opacity-90">{{ item.role }}</p>{% endif %}
            </div>
          </figcaption>
        </figure>
      {% endfor %}
    </div>
    <ul class="grid grid-cols-2 gap-4">
      <li class="flex h-20 items-center justify-center rounded-box bg-primary-content/10 px-4 text-center text-lg font-bold tracking-tight">Northwind</li>
      <li class="flex h-20 items-center justify-center rounded-box bg-primary-content/10 px-4 text-center text-lg font-bold tracking-tight">Bright Leaf</li>
      <li class="flex h-20 items-center justify-center rounded-box bg-primary-content/10 px-4 text-center text-lg font-bold tracking-tight">Orbit Café</li>
      <li class="flex h-20 items-center justify-center rounded-box bg-primary-content/10 px-4 text-center text-lg font-bold tracking-tight">Fieldnote</li>
      <li class="flex h-20 items-center justify-center rounded-box bg-primary-content/10 px-4 text-center text-lg font-bold tracking-tight">Harbor &amp; Co.</li>
      <li class="flex h-20 items-center justify-center rounded-box bg-primary-content/10 px-4 text-center text-lg font-bold tracking-tight">Blue Fern</li>
    </ul>
  </div>
</section>

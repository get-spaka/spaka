<section class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="flex flex-col items-start">
        <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <h2 class="mt-6 text-4xl font-bold text-balance md:text-5xl">Drop by, we are open</h2>
        <p class="mt-4 max-w-md text-lg text-pretty">Find us in the heart of the old town, two minutes from the market square.</p>
        <address class="mt-8 text-lg not-italic">
          <span class="block font-semibold">12 Market Street</span>
          <span class="block">Old Town, 10115</span>
          <a href="tel:+15550100200" class="mt-3 block underline underline-offset-4">+1 555 010 0200</a>
        </address>
        <a href="#" class="btn btn-primary btn-lg mt-8">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
          Get directions
        </a>
      </div>
      <div>
        <h3 class="text-sm font-bold tracking-widest uppercase">Opening hours</h3>
        <dl class="mt-4 divide-y divide-neutral-content/20 border-y border-neutral-content/20">
          {% for item in data.hours %}
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
              <dt class="text-lg font-semibold">{{ item.day }}</dt>
              <dd class="text-lg tabular-nums">{{ item.hours }}</dd>
              {% if item.note %}<dd class="w-full text-sm italic">{{ item.note }}</dd>{% endif %}
            </div>
          {% endfor %}
        </dl>
      </div>
    </div>
  </div>
</section>

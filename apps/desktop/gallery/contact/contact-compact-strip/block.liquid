<section class="border-y border-base-300 bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 text-sm sm:grid-cols-2 lg:grid-cols-5 lg:gap-10">
    <div class="flex items-start gap-3">
      <svg class="size-5 shrink-0 text-base-content/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
      <div>
        <h2 class="font-semibold">Address</h2>
        <address class="mt-1 text-base-content/70 not-italic">12 Market Street<br>Old Town, 10115</address>
        <a href="#" class="link link-hover mt-1 inline-block font-medium">Directions</a>
      </div>
    </div>
    <div class="flex items-start gap-3">
      <svg class="size-5 shrink-0 text-base-content/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
      <div>
        <h2 class="font-semibold">Phone</h2>
        <a href="tel:+15550100200" class="link link-hover mt-1 inline-block text-base-content/70">+1 555 010 0200</a>
      </div>
    </div>
    <div class="flex items-start gap-3">
      <svg class="size-5 shrink-0 text-base-content/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      <div class="min-w-0">
        <h2 class="font-semibold">Email</h2>
        <a href="mailto:hello@yourbusiness.com" class="link link-hover mt-1 inline-block break-all text-base-content/70">hello@yourbusiness.com</a>
      </div>
    </div>
    <div class="flex items-start gap-3 sm:col-span-2">
      <svg class="size-5 shrink-0 text-base-content/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      <div class="w-full">
        <h2 class="font-semibold">Hours</h2>
        <dl class="mt-1 grid gap-x-6 gap-y-1 sm:grid-cols-2">
          {% for item in data.hours %}
            <div class="flex justify-between gap-3">
              <dt class="text-base-content/70">{{ item.day }}</dt>
              <dd class="font-medium whitespace-nowrap tabular-nums">{{ item.hours }}</dd>
            </div>
          {% endfor %}
        </dl>
      </div>
    </div>
  </div>
</section>

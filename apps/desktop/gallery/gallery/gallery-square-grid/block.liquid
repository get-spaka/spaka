<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">A look around</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">Our place, our work and the things we make, in a few pictures.</p>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 md:gap-6">
      {% for item in data.gallery %}
        <li>
          <figure>
            {% if item.image %}
              <img src="{{ item.image }}" alt="{{ item.title }}" class="aspect-square w-full rounded-box object-cover">
            {% else %}
              {% assign tone = forloop.index0 | modulo: 4 %}
              <div class="flex aspect-square w-full items-center justify-center rounded-box bg-linear-to-br {% if tone == 0 %}from-primary/25 to-accent/20{% elsif tone == 1 %}from-secondary/25 to-primary/15{% elsif tone == 2 %}from-accent/25 to-secondary/15{% else %}from-base-300 to-primary/20{% endif %}">
                <svg class="size-10 text-base-content/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
            {% endif %}
            <figcaption class="mt-3">
              <p class="font-medium">{{ item.title }}</p>
              {% if item.category %}<p class="text-sm text-base-content/70">{{ item.category }}</p>{% endif %}
            </figcaption>
          </figure>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

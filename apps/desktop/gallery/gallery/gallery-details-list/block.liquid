<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-3xl px-4 py-16 md:py-24">
    <h2 class="font-serif text-3xl font-semibold text-balance md:text-4xl">Pictures and stories</h2>
    <p class="mt-4 text-lg text-pretty text-base-content/70">Open any picture to see it larger, with the story behind it.</p>
    <div class="mt-10 border-t border-base-300">
      {% for item in data.gallery %}
        {% assign tone = forloop.index0 | modulo: 4 %}
        <details class="group border-b border-base-300" {% if forloop.first %}open{% endif %}>
          <summary class="flex cursor-pointer list-none items-center gap-4 py-4 [&::-webkit-details-marker]:hidden">
            {% if item.image %}
              <img src="{{ item.image }}" alt="" class="size-16 shrink-0 rounded-field object-cover">
            {% else %}
              <div class="flex size-16 shrink-0 items-center justify-center rounded-field bg-linear-to-br {% if tone == 0 %}from-primary/25 to-accent/20{% elsif tone == 1 %}from-secondary/25 to-primary/15{% elsif tone == 2 %}from-accent/25 to-secondary/15{% else %}from-base-300 to-primary/20{% endif %}">
                <svg class="size-6 text-base-content/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
            {% endif %}
            <span class="min-w-0 flex-1">
              <span class="block font-semibold">{{ item.title }}</span>
              {% if item.category %}<span class="block text-sm text-base-content/70">{{ item.category }}</span>{% endif %}
            </span>
            <svg class="size-5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <figure class="pb-6">
            {% if item.image %}
              <img src="{{ item.image }}" alt="{{ item.title }}" class="aspect-video w-full rounded-box object-cover">
            {% else %}
              <div class="flex aspect-video w-full items-center justify-center rounded-box bg-linear-to-br {% if tone == 0 %}from-primary/25 to-accent/20{% elsif tone == 1 %}from-secondary/25 to-primary/15{% elsif tone == 2 %}from-accent/25 to-secondary/15{% else %}from-base-300 to-primary/20{% endif %}">
                <svg class="size-14 text-base-content/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
            {% endif %}
            {% if item.caption %}<figcaption class="mt-4 text-pretty text-base-content/70">{{ item.caption }}</figcaption>{% endif %}
          </figure>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

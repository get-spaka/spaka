<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold tracking-widest text-base-content/70 uppercase">Gallery</p>
        <h2 class="mt-2 text-4xl font-black text-balance md:text-5xl">See what we do</h2>
      </div>
      <a href="/contact" class="btn btn-primary self-start md:self-auto">Visit us</a>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-4">
      {% for item in data.gallery %}
        <li class="{% if forloop.first %}col-span-2 row-span-2{% endif %}">
          {% if item.image %}
            <img src="{{ item.image }}" alt="{{ item.title }}" class="aspect-square size-full rounded-box object-cover">
          {% else %}
            {% assign tone = forloop.index0 | modulo: 3 %}
            <div class="flex aspect-square size-full items-center justify-center rounded-box bg-linear-to-br {% if forloop.first %}from-primary/30 to-secondary/20{% elsif tone == 0 %}from-accent/25 to-primary/15{% elsif tone == 1 %}from-secondary/25 to-accent/15{% else %}from-base-300 to-primary/20{% endif %}">
              <svg class="{% if forloop.first %}size-16{% else %}size-10{% endif %} text-base-content/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              <span class="sr-only">{{ item.title }}</span>
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="grid gap-6 md:grid-cols-2 md:items-end">
      <h2 class="font-serif text-4xl font-bold text-balance md:text-5xl">Moments from our week</h2>
      <p class="text-lg text-pretty text-base-content/70">A wall of everyday pictures: the work in progress, the finished pieces and the people who stop by.</p>
    </div>
    <div class="mt-12 columns-1 gap-6 sm:columns-2 lg:columns-3">
      {% for item in data.gallery %}
        {% assign shape = forloop.index0 | modulo: 3 %}
        <figure class="mb-6 break-inside-avoid">
          {% if item.image %}
            <img src="{{ item.image }}" alt="{{ item.title }}" class="w-full rounded-box object-cover {% if shape == 0 %}aspect-3/4{% elsif shape == 1 %}aspect-square{% else %}aspect-4/3{% endif %}">
          {% else %}
            {% assign tone = forloop.index0 | modulo: 5 %}
            <div class="flex w-full items-center justify-center rounded-box bg-linear-to-b {% if shape == 0 %}aspect-3/4{% elsif shape == 1 %}aspect-square{% else %}aspect-4/3{% endif %} {% if tone == 0 %}from-primary/25 to-secondary/15{% elsif tone == 1 %}from-accent/25 to-primary/10{% elsif tone == 2 %}from-secondary/25 to-accent/15{% elsif tone == 3 %}from-base-300 to-accent/20{% else %}from-primary/15 to-base-300{% endif %}">
              <svg class="size-10 text-base-content/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </div>
          {% endif %}
          <figcaption class="mt-3">
            <p class="font-semibold">{{ item.title }}</p>
            {% if item.caption %}<p class="mt-1 text-sm text-pretty text-base-content/70">{{ item.caption }}</p>{% endif %}
          </figcaption>
        </figure>
      {% endfor %}
    </div>
  </div>
</section>

<section class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold text-balance md:text-4xl">Fresh from the workshop</h2>
        <p class="mt-4 text-lg text-pretty text-neutral-content">Swipe or scroll along the strip to see our latest pictures.</p>
      </div>
      <p class="flex items-center gap-2 text-sm font-medium text-neutral-content">
        Scroll for more
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </p>
    </div>
    <ul class="carousel mt-10 w-full gap-4 pb-4 md:gap-6">
      {% for item in data.gallery %}
        <li class="carousel-item w-4/5 flex-col sm:w-80">
          {% if item.image %}
            <img src="{{ item.image }}" alt="{{ item.title }}" class="aspect-4/5 w-full rounded-box object-cover">
          {% else %}
            {% assign tone = forloop.index0 | modulo: 3 %}
            <div class="flex aspect-4/5 w-full items-center justify-center rounded-box {% if tone == 0 %}bg-primary text-primary-content{% elsif tone == 1 %}bg-secondary text-secondary-content{% else %}bg-accent text-accent-content{% endif %}">
              <svg class="size-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </div>
          {% endif %}
          <h3 class="mt-4 font-semibold">{{ item.title }}</h3>
          {% if item.caption %}<p class="mt-1 text-sm text-pretty text-neutral-content">{{ item.caption }}</p>{% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Our gallery</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">Pictures of our place, our work and our products, sorted so you find what you came for.</p>
    </div>
    {% assign categories = data.gallery | map: "category" | compact | uniq %}
    {% assign loose = data.gallery | where_exp: "item", "item.category == blank" %}
    <div class="mt-12 space-y-14">
      {% for category in categories %}
        {% if category != blank %}
          {% assign members = data.gallery | where: "category", category %}
          <div>
            <div class="flex items-baseline justify-between gap-4 border-b border-base-300 pb-3">
              <h3 class="text-xl font-semibold">{{ category }}</h3>
              <p class="text-sm text-base-content/70">{{ members.size }} {% if members.size == 1 %}picture{% else %}pictures{% endif %}</p>
            </div>
            <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {% for item in data.gallery %}
                {% if item.category == category %}
                  <li>
                    <figure>
                      {% if item.image %}
                        <img src="{{ item.image }}" alt="{{ item.title }}" class="aspect-4/3 w-full rounded-box object-cover">
                      {% else %}
                        {% assign tone = forloop.index0 | modulo: 3 %}
                        <div class="flex aspect-4/3 w-full items-center justify-center rounded-box bg-linear-to-tr {% if tone == 0 %}from-primary/20 to-accent/20{% elsif tone == 1 %}from-secondary/20 to-primary/20{% else %}from-accent/20 to-secondary/20{% endif %}">
                          <svg class="size-10 text-base-content/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                        </div>
                      {% endif %}
                      <figcaption class="mt-3">
                        <p class="font-medium">{{ item.title }}</p>
                        {% if item.caption %}<p class="mt-1 text-sm text-pretty text-base-content/70">{{ item.caption }}</p>{% endif %}
                      </figcaption>
                    </figure>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
      {% if loose.size > 0 %}
        <div>
          <div class="flex items-baseline justify-between gap-4 border-b border-base-300 pb-3">
            <h3 class="text-xl font-semibold">More pictures</h3>
            <p class="text-sm text-base-content/70">{{ loose.size }} {% if loose.size == 1 %}picture{% else %}pictures{% endif %}</p>
          </div>
          <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {% for item in data.gallery %}
              {% if item.category == blank %}
                <li>
                  <figure>
                    {% if item.image %}
                      <img src="{{ item.image }}" alt="{{ item.title }}" class="aspect-4/3 w-full rounded-box object-cover">
                    {% else %}
                      {% assign tone = forloop.index0 | modulo: 3 %}
                      <div class="flex aspect-4/3 w-full items-center justify-center rounded-box bg-linear-to-tr {% if tone == 0 %}from-primary/20 to-accent/20{% elsif tone == 1 %}from-secondary/20 to-primary/20{% else %}from-accent/20 to-secondary/20{% endif %}">
                        <svg class="size-10 text-base-content/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                      </div>
                    {% endif %}
                    <figcaption class="mt-3">
                      <p class="font-medium">{{ item.title }}</p>
                      {% if item.caption %}<p class="mt-1 text-sm text-pretty text-base-content/70">{{ item.caption }}</p>{% endif %}
                    </figcaption>
                  </figure>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
  </div>
</section>

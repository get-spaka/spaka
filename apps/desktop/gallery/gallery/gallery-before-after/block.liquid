<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-5xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Before and after</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">The best way to judge our work is to see where each job started and how it ended.</p>
    </div>
    <ul class="mt-12 space-y-12">
      {% for item in data.gallery %}
        {% assign tone = forloop.index0 | modulo: 3 %}
        <li class="rounded-box bg-base-100 p-4 md:p-6">
          <div class="grid grid-cols-2 gap-3 md:gap-6">
            <figure>
              {% if item.before %}
                <img src="{{ item.before }}" alt="{{ item.title }}, before" class="aspect-4/3 w-full rounded-box object-cover">
              {% else %}
                <div class="flex aspect-4/3 w-full items-center justify-center rounded-box bg-base-300">
                  <svg class="size-10 text-base-content/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                </div>
              {% endif %}
              <figcaption class="mt-3"><span class="badge badge-ghost">Before</span></figcaption>
            </figure>
            <figure>
              {% if item.image %}
                <img src="{{ item.image }}" alt="{{ item.title }}, after" class="aspect-4/3 w-full rounded-box object-cover">
              {% else %}
                <div class="flex aspect-4/3 w-full items-center justify-center rounded-box bg-linear-to-br {% if tone == 0 %}from-primary/25 to-accent/20{% elsif tone == 1 %}from-secondary/25 to-primary/15{% else %}from-accent/25 to-secondary/15{% endif %}">
                  <svg class="size-10 text-base-content/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
                </div>
              {% endif %}
              <figcaption class="mt-3"><span class="badge badge-primary">After</span></figcaption>
            </figure>
          </div>
          <div class="mt-5 md:mt-6">
            <h3 class="text-lg font-semibold">{{ item.title }}</h3>
            {% if item.caption %}<p class="mt-1 text-pretty text-base-content/70">{{ item.caption }}</p>{% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

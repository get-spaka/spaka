<footer class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-6xl px-4 py-14 text-center md:py-20">
    <a href="/" class="inline-flex flex-col items-center gap-3">
      <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
      <span class="font-serif text-3xl tracking-wide md:text-4xl">Your business</span>
    </a>
    <p class="mx-auto mt-3 max-w-md text-neutral-content/80">Seasonal cooking and good wine, every evening in the heart of town.</p>
    <div class="mt-12 grid gap-10 border-y border-neutral-content/15 py-10 md:grid-cols-3">
      <div>
        <h2 class="text-xs font-semibold tracking-widest text-neutral-content/80 uppercase">Opening hours</h2>
        <ul class="mt-4 space-y-1">
          <li>Tuesday – Thursday · 18:00 – 22:00</li>
          <li>Friday – Saturday · 18:00 – 23:00</li>
          <li>Sunday lunch · 12:00 – 15:00</li>
          <li class="text-neutral-content/80">Closed on Mondays</li>
        </ul>
      </div>
      <div>
        <h2 class="text-xs font-semibold tracking-widest text-neutral-content/80 uppercase">Reservations</h2>
        <p class="mt-4">Book online or call us,<br>groups welcome.</p>
        <a href="#" class="btn btn-primary mt-4">Book a table</a>
        <p class="mt-3"><a href="#" class="link link-hover">+1 555 0142</a></p>
      </div>
      <div>
        <h2 class="text-xs font-semibold tracking-widest text-neutral-content/80 uppercase">Find us</h2>
        <address class="mt-4 not-italic">
          8 Harbour Lane<br>
          Old Town, 10115
        </address>
        <a href="#" class="link link-hover mt-4 inline-flex items-center gap-1"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>Get directions</a>
      </div>
    </div>
    <nav aria-label="Footer" class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
      {% for item in data.navigation %}{% unless item.place == "header" or item.place == "social" %}
      <a href="{{ item.href }}" class="link link-hover" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endunless %}{% endfor %}
    </nav>
    <nav aria-label="Social media" class="mt-6 flex justify-center gap-1">
      {% for item in data.navigation %}{% if item.place == "social" %}
      {% assign network = item.label | downcase %}
      <a href="{{ item.href }}" class="btn btn-ghost btn-square btn-sm" aria-label="{{ item.label }}">
        {% case network %}
        {% when "facebook" %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        {% when "instagram" %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/></svg>
        {% when "linkedin" %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
        {% when "x", "twitter" %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4l11.733 16h4.267l-11.733-16z"/><path d="M4 20l6.768-6.768m2.46-2.46L20 4"/></svg>
        {% when "youtube" %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>
        {% else %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        {% endcase %}
      </a>
      {% endif %}{% endfor %}
    </nav>
    <p class="mt-6 text-sm text-neutral-content/80">© 2026 Your business. All rights reserved.</p>
  </div>
</footer>

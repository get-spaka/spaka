<footer class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="relative flex aspect-4/3 items-center justify-center overflow-hidden rounded-box bg-linear-to-br from-primary/20 to-accent/20 sm:aspect-video lg:aspect-auto lg:min-h-72" role="img" aria-label="Map of the shop’s location">
        <svg class="absolute size-48 text-base-content/10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/></svg>
        <div class="relative flex flex-col items-center gap-2 rounded-box bg-base-100 px-5 py-4 text-center shadow-sm">
          <svg class="size-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="font-semibold">Your business</span>
          <span class="text-sm text-base-content/70">12 Market Street</span>
        </div>
      </div>
      <div class="flex flex-col gap-8">
        <a href="/" class="flex items-center gap-2">
          <svg class="size-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>
          <span class="text-lg font-bold">Your business</span>
        </a>
        <div class="grid gap-8 sm:grid-cols-2">
          <div>
            <h2 class="flex items-center gap-2 font-semibold"><svg class="size-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>Visit us</h2>
            <address class="mt-3 text-base-content/70 not-italic">
              12 Market Street<br>
              Old Town, 10115<br>
              <a href="#" class="link link-hover">+1 555 0142</a>
            </address>
            <a href="#" class="btn btn-outline btn-sm mt-4">Get directions</a>
          </div>
          <div>
            <h2 class="flex items-center gap-2 font-semibold"><svg class="size-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>Opening hours</h2>
            <ul class="mt-3 space-y-1 text-base-content/70">
              <li class="flex justify-between gap-4"><span>Monday – Friday</span><span>9:00 – 18:00</span></li>
              <li class="flex justify-between gap-4"><span>Saturday</span><span>10:00 – 17:00</span></li>
              <li class="flex justify-between gap-4"><span>Sunday</span><span>Closed</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-6 border-t border-base-300 pt-6 md:flex-row md:items-center md:justify-between">
      <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {% for item in data.navigation %}{% unless item.place == "header" or item.place == "social" %}
        <a href="{{ item.href }}" class="link link-hover" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endunless %}{% endfor %}
      </nav>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
        <p class="text-sm text-base-content/70">© 2026 Your business</p>
        <nav aria-label="Social media" class="flex gap-1">
          {% for item in data.navigation %}{% if item.place == "social" %}
          {% assign network = item.label | downcase %}
          <a href="{{ item.href }}" class="btn btn-ghost btn-square btn-sm" aria-label="{{ item.label }}">
            {% case network %}
            {% when "facebook" %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            {% when "instagram" %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/></svg>
            {% when "linkedin" %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            {% when "x", "twitter" %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4l11.733 16h4.267l-11.733-16z"/><path d="M4 20l6.768-6.768m2.46-2.46L20 4"/></svg>
            {% when "youtube" %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>
            {% else %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            {% endcase %}
          </a>
          {% endif %}{% endfor %}
        </nav>
      </div>
    </div>
  </div>
</footer>

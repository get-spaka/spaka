<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <h2 class="text-center text-sm font-semibold tracking-widest text-base-content/70 uppercase">Trusted by local businesses</h2>
    <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-6 md:gap-x-14">
      {% for item in data.logos %}
        {% assign style = forloop.index0 | modulo: 4 %}
        {% capture mark %}
          {% if item.logo %}
            <img src="{{ item.logo }}" alt="{{ item.name }}" class="h-8 w-auto max-w-36 object-contain opacity-70 grayscale">
          {% else %}
            <span class="text-xl text-base-content/70 {% case style %}{% when 0 %}font-black tracking-tight{% when 1 %}font-serif font-semibold italic{% when 2 %}font-light tracking-widest uppercase{% else %}font-bold lowercase{% endcase %}">{{ item.name }}</span>
          {% endif %}
        {% endcapture %}
        <li class="flex items-center">
          {% if item.href %}<a href="{{ item.href }}" class="flex items-center transition-opacity hover:opacity-80">{{ mark }}</a>{% else %}{{ mark }}{% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

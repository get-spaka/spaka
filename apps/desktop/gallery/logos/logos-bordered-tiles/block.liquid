<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Our partners</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">We work hand in hand with people who share our standards, from the first sketch to the final delivery.</p>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-3">
      {% for item in data.logos %}
        {% assign style = forloop.index0 | modulo: 3 %}
        {% capture mark %}
          {% if item.logo %}
            <img src="{{ item.logo }}" alt="{{ item.name }}" class="h-10 w-auto max-w-40 object-contain">
          {% else %}
            <span class="text-lg md:text-xl {% case style %}{% when 0 %}font-extrabold tracking-tight{% when 1 %}font-medium tracking-widest uppercase{% else %}font-serif font-bold{% endcase %}">{{ item.name }}</span>
          {% endif %}
          {% if item.caption %}<span class="text-sm text-base-content/70">{{ item.caption }}</span>{% endif %}
        {% endcapture %}
        <li>
          {% if item.href %}
            <a href="{{ item.href }}" class="flex aspect-video flex-col items-center justify-center gap-2 rounded-box border border-base-300 bg-base-100 p-6 text-center transition-colors hover:border-primary">{{ mark }}</a>
          {% else %}
            <div class="flex aspect-video flex-col items-center justify-center gap-2 rounded-box border border-base-300 bg-base-100 p-6 text-center">{{ mark }}</div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

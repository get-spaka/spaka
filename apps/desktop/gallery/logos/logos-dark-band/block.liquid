<section class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-6xl px-4 py-14 md:py-20">
    <div class="flex flex-col gap-10 md:flex-row md:items-center md:gap-16">
      <div class="md:w-64 md:shrink-0">
        <h2 class="text-2xl font-bold text-balance">Chosen by teams across the region</h2>
        <p class="mt-2 text-neutral-content">Gyms, shops and workshops that count on us every week.</p>
      </div>
      <ul class="flex grow flex-wrap items-center gap-x-10 gap-y-6 border-neutral-content/20 md:border-l md:pl-16">
        {% for item in data.logos %}
          {% assign style = forloop.index0 | modulo: 3 %}
          {% capture mark %}
            {% if item.logo %}
              <span class="inline-flex rounded-box bg-base-100 px-4 py-2"><img src="{{ item.logo }}" alt="{{ item.name }}" class="h-7 w-auto max-w-32 object-contain"></span>
            {% else %}
              <span class="text-xl md:text-2xl {% case style %}{% when 0 %}font-black tracking-tighter uppercase{% when 1 %}font-serif font-semibold italic{% else %}font-light tracking-widest uppercase{% endcase %}">{{ item.name }}</span>
            {% endif %}
          {% endcapture %}
          <li class="flex items-center">
            {% if item.href %}<a href="{{ item.href }}" class="link link-hover">{{ mark }}</a>{% else %}{{ mark }}{% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Certified and recognized</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">The standards we hold ourselves to, checked by people outside our walls.</p>
    </div>
    <ul class="mt-12 flex flex-wrap justify-center gap-x-8 gap-y-10">
      {% for item in data.logos %}
        {% capture badge %}
          <span class="mx-auto grid size-24 place-items-center rounded-full border-4 border-primary bg-base-100">
            {% if item.logo %}
              <img src="{{ item.logo }}" alt="{{ item.name }}" class="size-16 rounded-full object-contain">
            {% else %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-10 text-primary" aria-hidden="true"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/></svg>
            {% endif %}
          </span>
          <span class="mt-4 block font-semibold tracking-wide">{{ item.name }}</span>
        {% endcapture %}
        <li class="w-36 text-center sm:w-40">
          {% if item.href %}<a href="{{ item.href }}" class="block hover:underline">{{ badge }}</a>{% else %}{{ badge }}{% endif %}
          {% if item.caption %}<p class="mt-1 text-sm text-base-content/70">{{ item.caption }}</p>{% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

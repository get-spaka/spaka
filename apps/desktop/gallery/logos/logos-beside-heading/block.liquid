<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 md:py-24 lg:grid-cols-5 lg:items-center">
    <div class="lg:col-span-2">
      <p class="text-sm font-semibold tracking-widest text-base-content/70 uppercase">Our suppliers</p>
      <h2 class="mt-3 text-3xl font-bold text-balance md:text-4xl">Sourced from people we know by name</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">Everything we serve starts with a handful of growers and makers close by. We visit them, we taste with them, and we have worked together for years.</p>
      <a href="/about" class="btn mt-8 btn-outline">Meet our producers</a>
    </div>
    <ul class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:col-span-3">
      {% for item in data.logos %}
        {% assign style = forloop.index0 | modulo: 3 %}
        {% capture mark %}
          {% if item.logo %}
            <img src="{{ item.logo }}" alt="{{ item.name }}" class="h-12 w-auto max-w-40 object-contain">
          {% else %}
            <span class="block text-lg leading-tight {% case style %}{% when 0 %}font-serif font-bold italic{% when 1 %}font-black tracking-tight uppercase{% else %}font-semibold tracking-wide{% endcase %}">{{ item.name }}</span>
          {% endif %}
        {% endcapture %}
        <li class="border-l-2 border-primary pl-4">
          {% if item.href %}<a href="{{ item.href }}" class="link link-hover">{{ mark }}</a>{% else %}{{ mark }}{% endif %}
          {% if item.caption %}<p class="mt-2 text-sm text-base-content/70">{{ item.caption }}</p>{% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

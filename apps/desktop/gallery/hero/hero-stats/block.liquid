<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <span class="badge badge-soft badge-primary">New: online booking is live</span>
      <h1 class="mt-6 text-4xl font-extrabold text-balance md:text-6xl">The easiest way to run your studio</h1>
      <p class="mt-6 text-lg text-pretty text-base-content/70">Bookings, payments and reminders in one place, so you can focus on your clients.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="#" class="btn btn-primary btn-lg">Try it free</a>
        <a href="#" class="btn btn-outline btn-lg">Book a demo</a>
      </div>
    </div>
    <div class="stats stats-vertical mx-auto mt-16 grid w-full max-w-3xl border border-base-300 bg-base-200 md:stats-horizontal">
      {% for stat in data.stats %}
        <div class="stat place-items-center">
          <p class="stat-title text-base-content/70">{{ stat.label }}</p>
          <p class="stat-value {% if forloop.first %}text-primary{% endif %}">{{ stat.value }}</p>
          {% if stat.note != blank %}<p class="stat-desc text-base-content/70">{{ stat.note }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

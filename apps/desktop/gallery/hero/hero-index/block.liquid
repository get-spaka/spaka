<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="grid gap-6 md:grid-cols-12 md:items-end">
      <h1 class="text-4xl leading-tight font-semibold tracking-tight text-balance md:col-span-8 md:text-6xl">What we do, and how well</h1>
      <p class="text-lg text-pretty text-base-content/70 md:col-span-4">A short statement of the practice: who it serves, since when, and what sets it apart.</p>
    </div>
    <ol class="mt-14 border-b border-base-content/20">
      {% for item in data.services %}
        <li class="grid grid-cols-12 items-baseline gap-x-4 gap-y-2 border-t border-base-content/20 py-6">
          <span class="col-span-2 text-sm text-base-content/60 tabular-nums md:col-span-1">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <h2 class="col-span-10 text-2xl font-semibold tracking-tight md:col-span-5 md:text-3xl">{% if item.href %}<a href="{{ item.href }}" class="link link-hover">{{ item.name }}</a>{% else %}{{ item.name }}{% endif %}</h2>
          <p class="col-span-10 col-start-3 text-base-content/70 md:col-span-4 md:col-start-auto">{{ item.summary }}</p>
          <p class="col-span-10 col-start-3 text-sm font-medium md:col-span-2 md:col-start-auto md:text-right">{{ item.price }}</p>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

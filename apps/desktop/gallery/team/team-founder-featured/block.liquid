<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    {% for member in data.team limit: 1 %}
      {% assign words = member.name | split: " " %}
      <article class="grid items-center gap-8 md:grid-cols-5 md:gap-12">
        {% if member.photo %}
          <img src="{{ member.photo }}" alt="{{ member.name }}" class="aspect-3/4 w-full rounded-box object-cover md:col-span-2">
        {% else %}
          <div class="flex aspect-3/4 w-full items-center justify-center rounded-box bg-linear-to-br from-primary/20 to-secondary/20 md:col-span-2">
            <span class="text-7xl font-bold text-base-content/70">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span>
          </div>
        {% endif %}
        <div class="md:col-span-3">
          <p class="text-sm font-semibold tracking-widest uppercase text-base-content/70">A word from our founder</p>
          <h2 class="mt-3 text-3xl font-bold text-balance md:text-5xl">{{ member.name }}</h2>
          {% if member.role %}<p class="mt-2 text-lg text-base-content/70">{{ member.role }}</p>{% endif %}
          {% if member.bio %}<p class="mt-6 border-l-4 border-primary pl-5 text-xl leading-relaxed text-pretty md:text-2xl">{{ member.bio }}</p>{% endif %}
          {% if member.email %}
            <a href="mailto:{{ member.email }}" class="btn btn-outline mt-8">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              Write to {{ words.first }}
            </a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
    <h3 class="mt-16 text-xl font-semibold md:mt-24">And the rest of the team</h3>
    <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {% for member in data.team offset: 1 %}
        <li class="flex items-center gap-4">
          {% if member.photo %}
            <img src="{{ member.photo }}" alt="{{ member.name }}" class="size-14 shrink-0 rounded-full object-cover">
          {% else %}
            {% assign words = member.name | split: " " %}
            <div class="flex size-14 shrink-0 items-center justify-center rounded-full bg-secondary text-secondary-content">
              <span class="font-semibold">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span>
            </div>
          {% endif %}
          <div>
            <p class="font-semibold">{{ member.name }}</p>
            {% if member.role %}<p class="text-sm text-base-content/70">{{ member.role }}</p>{% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

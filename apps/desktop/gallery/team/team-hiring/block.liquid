<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold text-balance md:text-4xl">A growing team</h2>
        <p class="mt-4 text-lg text-pretty text-base-content/70">We started with one person and a good idea. Here is who makes it all happen today.</p>
      </div>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
      {% for member in data.team %}
        <li>
          {% if member.photo %}
            <img src="{{ member.photo }}" alt="{{ member.name }}" class="aspect-square w-full rounded-box object-cover">
          {% else %}
            {% assign words = member.name | split: " " %}
            <div class="flex aspect-square w-full items-center justify-center rounded-box bg-linear-to-br from-primary/20 to-secondary/20">
              <span class="text-4xl font-bold text-base-content/70">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span>
            </div>
          {% endif %}
          <h3 class="mt-3 font-semibold">{{ member.name }}</h3>
          {% if member.role %}<p class="text-sm text-base-content/70">{{ member.role }}</p>{% endif %}
        </li>
      {% endfor %}
      <li class="col-span-2 md:col-span-1">
        <div class="flex h-full flex-col justify-center gap-4 rounded-box bg-primary p-6 text-primary-content">
          <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/></svg>
          <h3 class="text-2xl font-bold">We're hiring</h3>
          <p class="text-primary-content">Could your name be here next? We are looking for a friendly, careful person to join us.</p>
          <a href="/contact" class="btn self-start border-0 bg-primary-content text-primary hover:bg-primary-content/90">See the open roles</a>
        </div>
      </li>
    </ul>
  </div>
</section>

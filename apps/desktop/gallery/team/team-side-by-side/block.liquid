<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 md:py-24 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <p class="text-sm font-semibold tracking-widest uppercase text-base-content/70">Our team</p>
      <h2 class="mt-3 text-3xl font-bold text-balance md:text-4xl">Small team, careful work</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">There are only a few of us, so you will always deal with someone who knows your name and your project from start to finish.</p>
      <a href="/contact" class="btn btn-primary mt-8">Work with us</a>
    </div>
    <div class="grid gap-8 sm:grid-cols-2 lg:col-span-3">
      {% for member in data.team %}
        <article>
          {% if member.photo %}
            <img src="{{ member.photo }}" alt="{{ member.name }}" class="aspect-square w-full rounded-box object-cover">
          {% else %}
            {% assign words = member.name | split: " " %}
            <div class="flex aspect-square w-full items-center justify-center rounded-box bg-linear-to-br from-secondary/20 to-primary/20">
              <span class="text-5xl font-semibold text-base-content/70">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span>
            </div>
          {% endif %}
          <h3 class="mt-4 text-xl font-semibold">{{ member.name }}</h3>
          {% if member.role %}<p class="mt-1 text-base-content/70">{{ member.role }}</p>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">The crew</h2>
      <p class="mt-4 text-lg text-pretty text-neutral-content">Different skills, one way of working: do it properly, and do it on time.</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {% for member in data.team %}
        <article class="flex flex-col items-center rounded-box border border-neutral-content/20 p-6 text-center md:p-8">
          {% if member.photo %}
            <img src="{{ member.photo }}" alt="{{ member.name }}" class="size-24 rounded-full object-cover">
          {% else %}
            {% assign words = member.name | split: " " %}
            <div class="flex size-24 items-center justify-center rounded-full bg-primary text-primary-content">
              <span class="text-2xl font-bold">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span>
            </div>
          {% endif %}
          <h3 class="mt-5 text-xl font-semibold">{{ member.name }}</h3>
          {% if member.role %}<p class="mt-1 text-sm tracking-widest uppercase text-neutral-content">{{ member.role }}</p>{% endif %}
          {% if member.email or member.linkedin or member.instagram %}
            <div class="mt-4 flex gap-1">
              {% if member.email %}
                <a href="mailto:{{ member.email }}" class="btn btn-ghost btn-circle btn-sm text-neutral-content" aria-label="Write to {{ member.name }}">
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </a>
              {% endif %}
              {% if member.linkedin %}
                <a href="{{ member.linkedin }}" class="btn btn-ghost btn-circle btn-sm text-neutral-content" aria-label="{{ member.name }} on LinkedIn">
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                </a>
              {% endif %}
              {% if member.instagram %}
                <a href="{{ member.instagram }}" class="btn btn-ghost btn-circle btn-sm text-neutral-content" aria-label="{{ member.name }} on Instagram">
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/></svg>
                </a>
              {% endif %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

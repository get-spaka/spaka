<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-balance md:text-4xl">Meet the team</h2>
      <p class="mt-4 text-lg text-pretty text-base-content/70">A small team of people who know their trade and care about every customer who walks through the door.</p>
    </div>
    <div class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {% for member in data.team %}
        <article>
          {% if member.photo %}
            <img src="{{ member.photo }}" alt="{{ member.name }}" class="aspect-4/5 w-full rounded-box object-cover">
          {% else %}
            {% assign words = member.name | split: " " %}
            <div class="flex aspect-4/5 w-full items-center justify-center rounded-box bg-linear-to-br from-primary/20 to-accent/20">
              <span class="text-5xl font-bold tracking-wide text-base-content/70">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span>
            </div>
          {% endif %}
          <div class="mt-4 flex items-start justify-between gap-4">
            <div>
              <h3 class="text-lg font-semibold">{{ member.name }}</h3>
              {% if member.role %}<p class="mt-0.5 text-sm text-base-content/70">{{ member.role }}</p>{% endif %}
            </div>
            {% if member.linkedin %}
              <a href="{{ member.linkedin }}" class="btn btn-ghost btn-circle btn-sm" aria-label="{{ member.name }} on LinkedIn">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
              </a>
            {% endif %}
          </div>
          {% if member.bio %}<p class="mt-3 text-pretty text-base-content/70">{{ member.bio }}</p>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

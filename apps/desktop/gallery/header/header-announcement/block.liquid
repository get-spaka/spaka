<header class="bg-base-100 text-base-content shadow-sm">
  <div class="bg-primary px-4 py-2 text-center text-sm text-primary-content">
    <p>New: our spring collection is here. <a href="#" class="font-semibold underline">See what’s new</a></p>
  </div>
  <div class="navbar mx-auto max-w-6xl px-4">
    <div class="navbar-start gap-1">
      <div class="dropdown md:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost btn-square" aria-label="Open menu">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>
        </div>
        <ul tabindex="0" class="menu dropdown-content z-10 mt-3 w-52 rounded-box bg-base-100 p-2 shadow-lg">
          {% for item in data.navigation %}{% unless item.place == "footer" or item.place == "social" %}
          {% if item.links.size > 0 %}
          <li>
            <details>
              <summary>{{ item.label }}</summary>
              <ul>
                {% for link in item.links %}<li><a href="{{ link.href }}" {% if page.url == link.href %}aria-current="page"{% endif %}>{{ link.label }}</a></li>{% endfor %}
              </ul>
            </details>
          </li>
          {% else %}
          <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endif %}
          {% endunless %}{% endfor %}
        </ul>
      </div>
      <a href="/" class="flex items-center gap-2">
        <svg class="size-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>
        <span class="text-lg font-bold whitespace-nowrap">Your business</span>
      </a>
    </div>
    <nav aria-label="Main" class="navbar-center hidden md:flex">
      <ul class="menu menu-horizontal gap-1">
        {% for item in data.navigation %}{% unless item.place == "footer" or item.place == "social" %}
        {% if item.links.size > 0 %}
        <li>
          <details>
            <summary>{{ item.label }}</summary>
            <ul class="z-10 w-52 rounded-box bg-base-100 p-2 shadow-lg">
              {% for link in item.links %}<li><a href="{{ link.href }}" {% if page.url == link.href %}aria-current="page"{% endif %}>{{ link.label }}</a></li>{% endfor %}
            </ul>
          </details>
        </li>
        {% else %}
        <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}
        {% endunless %}{% endfor %}
      </ul>
    </nav>
    <div class="navbar-end">
      <a href="#" class="btn btn-primary btn-sm sm:btn-md">Book a call</a>
    </div>
  </div>
</header>

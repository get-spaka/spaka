<header class="bg-base-200 text-base-content">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 md:flex-col md:gap-3 md:py-6">
    <a href="/" class="flex items-center gap-2">
      <svg class="size-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>
      <span class="text-xl font-semibold tracking-wide">Your business</span>
    </a>
    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm">
        {% for item in data.navigation %}{% unless item.place == "footer" or item.place == "social" %}
        {% if item.links.size > 0 %}
        <li>
          <details class="dropdown dropdown-center">
            <summary class="link link-hover flex cursor-pointer list-none items-center gap-1">{{ item.label }}<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
            <ul class="menu dropdown-content z-10 mt-3 w-52 rounded-box bg-base-100 p-2 shadow-lg">
              {% for link in item.links %}<li><a href="{{ link.href }}" {% if page.url == link.href %}aria-current="page"{% endif %}>{{ link.label }}</a></li>{% endfor %}
            </ul>
          </details>
        </li>
        {% else %}
        <li><a href="{{ item.href }}" class="link link-hover" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}
        {% endunless %}{% endfor %}
      </ul>
    </nav>
    <details class="dropdown dropdown-end md:hidden">
      <summary class="btn btn-ghost btn-square" aria-label="Open menu">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>
      </summary>
      <ul class="menu dropdown-content z-10 mt-3 w-52 rounded-box bg-base-100 p-2 shadow-lg">
        {% for item in data.navigation %}{% unless item.place == "footer" or item.place == "social" %}
        {% if item.links.size > 0 %}
        <li>
          <details>
            <summary>{{ item.label }}</summary>
            <ul>
              {% for link in item.links %}<li><a href="{{ link.href }}" {% if page.url == link.href %}aria-current="page"{% endif %}>{{ link.label }}</a></li>{% endfor %}
            </ul>
          </details>
        </li>
        {% else %}
        <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}
        {% endunless %}{% endfor %}
      </ul>
    </details>
  </div>
</header>

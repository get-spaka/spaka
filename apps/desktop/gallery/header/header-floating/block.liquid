<header class="bg-linear-to-br from-primary/10 to-accent/10 px-4 pt-4 text-base-content">
  <div class="navbar mx-auto max-w-5xl gap-2 rounded-box border border-base-300 bg-base-100 px-3 shadow-lg md:rounded-full md:px-4">
    <div class="navbar-start">
      <a href="/" class="flex items-center gap-2">
        <svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>
        <span class="font-bold whitespace-nowrap">Your business</span>
      </a>
    </div>
    <nav aria-label="Main" class="navbar-center hidden md:flex">
      <ul class="menu menu-horizontal menu-sm gap-1">
        {% for item in data.navigation %}{% unless item.place == "footer" or item.place == "social" %}
        {% if item.links.size > 0 %}
        <li>
          <details>
            <summary>{{ item.label }}</summary>
            <ul class="z-10 w-52 rounded-box bg-base-100 p-2 text-base-content shadow-lg">
              {% for link in item.links %}<li><a href="{{ link.href }}" {% if page.url == link.href %}aria-current="page"{% endif %}>{{ link.label }}</a></li>{% endfor %}
            </ul>
          </details>
        </li>
        {% else %}
        <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}
        {% endunless %}{% endfor %}
      </ul>
    </nav>
    <div class="navbar-end gap-1">
      <a href="/contact" class="btn btn-primary btn-sm rounded-full">Say hello</a>
      <div class="dropdown dropdown-end md:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost btn-circle btn-sm" aria-label="Open menu">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>
        </div>
        <ul tabindex="0" class="menu dropdown-content z-10 mt-3 w-56 rounded-box bg-base-100 p-2 text-base-content shadow-lg">
          {% for item in data.navigation %}{% unless item.place == "footer" or item.place == "social" %}
          {% if item.links.size > 0 %}
          <li>
            <details>
              <summary>{{ item.label }}</summary>
              <ul>
                {% for link in item.links %}<li><a href="{{ link.href }}" {% if page.url == link.href %}aria-current="page"{% endif %}>{{ link.label }}</a></li>{% endfor %}
              </ul>
            </details>
          </li>
          {% else %}
          <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endif %}
          {% endunless %}{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</header>

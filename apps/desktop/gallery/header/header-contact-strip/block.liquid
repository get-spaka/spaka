<header class="bg-base-100 text-base-content shadow-sm">
  <div class="bg-secondary text-secondary-content">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-6 gap-y-1 px-4 py-2 text-sm sm:justify-between">
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-1">
        <a href="#" class="flex items-center gap-2 hover:underline">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>01 23 45 67 89</span>
        </a>
        <p class="flex items-center gap-2">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          <span>Mon–Fri 9am–6pm, Sat 10am–4pm</span>
        </p>
      </div>
      <div class="hidden items-center gap-x-6 sm:flex">
        <p class="flex items-center gap-2">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.99-5.54 10.19-7.4 11.79a1 1 0 0 1-1.2 0C9.54 20.19 4 14.99 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          <span>12 Market Street</span>
        </p>
        <a href="#" class="hidden items-center gap-2 hover:underline lg:flex">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span>hello@yourbusiness.com</span>
        </a>
      </div>
    </div>
  </div>
  <div class="navbar mx-auto max-w-6xl gap-4 px-4">
    <div class="navbar-start">
      <a href="/" class="flex items-center gap-2">
        <svg class="size-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>
        <span class="text-lg font-bold whitespace-nowrap">Your business</span>
      </a>
    </div>
    <nav aria-label="Main" class="navbar-center hidden md:flex">
      <ul class="menu menu-horizontal gap-1">
        {% for item in data.navigation %}{% unless item.place == "footer" or item.place == "social" %}
        {% if item.links.size > 0 %}
        <li>
          <details>
            <summary>{{ item.label }}</summary>
            <ul class="z-10 w-52 rounded-box bg-base-100 p-2 text-base-content shadow-lg">
              {% for link in item.links %}<li><a href="{{ link.href }}" {% if page.url == link.href %}aria-current="page"{% endif %}>{{ link.label }}</a></li>{% endfor %}
            </ul>
          </details>
        </li>
        {% else %}
        <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}
        {% endunless %}{% endfor %}
      </ul>
    </nav>
    <div class="navbar-end gap-2">
      <a href="/contact" class="btn btn-secondary btn-sm sm:btn-md">Make an appointment</a>
      <div class="dropdown dropdown-end md:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost btn-square" aria-label="Open menu">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>
        </div>
        <ul tabindex="0" class="menu dropdown-content z-10 mt-3 w-56 rounded-box bg-base-100 p-2 text-base-content shadow-lg">
          {% for item in data.navigation %}{% unless item.place == "footer" or item.place == "social" %}
          {% if item.links.size > 0 %}
          <li>
            <details>
              <summary>{{ item.label }}</summary>
              <ul>
                {% for link in item.links %}<li><a href="{{ link.href }}" {% if page.url == link.href %}aria-current="page"{% endif %}>{{ link.label }}</a></li>{% endfor %}
              </ul>
            </details>
          </li>
          {% else %}
          <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endif %}
          {% endunless %}{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</header>

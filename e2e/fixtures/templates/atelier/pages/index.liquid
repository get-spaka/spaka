<!doctype html>
<html lang="en">
<head><title>Atelier Nord — Ceramics</title></head>
<body>
{% render 'header' %}
<main>
<section class="mx-auto max-w-6xl px-6 py-24">
  <h1 class="font-heading text-6xl leading-tight md:text-8xl" data-reveal>Clay, slowly.</h1>
  <p class="mt-6 max-w-xl text-lg opacity-80" data-reveal>Bowls, cups and vases thrown by hand in a small studio by the harbour.</p>
</section>
<section class="mx-auto max-w-6xl px-6 pb-24">
  <img src="/media/glaze.jpg" class="aspect-[16/7] w-full rounded-box object-cover" data-reveal>
</section>
<section class="bg-base-200 py-24">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 md:grid-cols-3">
    <div data-reveal><h2 class="font-heading text-2xl">Thrown</h2><p class="mt-2 opacity-80">Every piece starts on the wheel.</p></div>
    <div data-reveal><h2 class="font-heading text-2xl">Glazed</h2><p class="mt-2 opacity-80">Glazes mixed in the studio, by the batch.</p></div>
    <div data-reveal><h2 class="font-heading text-2xl">Fired</h2><p class="mt-2 opacity-80">Twice, the second time at 1280 °C.</p></div>
  </div>
</section>
</main>
</body>
</html>
